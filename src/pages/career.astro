---
// src/pages/career.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SEOJsonLd from '../components/SEOJsonLd.astro';

const careerItems = (await getCollection('career')).sort((a, b) => a.data.order - b.data.order);
---

<Layout 
  title="Career Timeline & Experience | Aastik Tripathi"
  description="Chronological career timeline, engineering roles, and achievements of Aastik Tripathi."
>
  <SEOJsonLd
    type="website"
    title="Career Timeline - Aastik Tripathi"
    description="Professional experience, roles, and milestones."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#0d0f14] text-[#e6e8ec] py-12 sm:py-16">
    <div class="max-w-5xl px-4 mx-auto sm:px-6 space-y-12">

      <!-- Header Banner Frame with Solid Block Shadow -->
      <div class="border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] p-6 sm:p-12 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842]">
        <div class="inline-block px-3 py-1 border-2 border-[#000000] bg-[#e5b842] text-[#0d0f14] font-mono text-[10px] font-bold rounded-full shadow-[3px_3px_0px_#ffffff] mb-4">
          CAREER VIEWER
        </div>
        <h1 class="hero-heading text-[#e6e8ec] mb-3">
          Experience &amp; <span class="text-[#e5b842] underline decoration-[3px] decoration-[#e5b842]">Timeline</span>
        </h1>
        <p class="text-xs sm:text-sm font-mono text-neutral-400 max-w-2xl leading-relaxed">
          A chronological journey through software engineering roles, distributed systems challenges, and key technical milestones.
        </p>

        <!-- Quick Career Summary Metrics with Hard Shadows -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-8 mt-8 border-t border-[#2e3545]">
          <div class="p-3 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl text-center shadow-[3px_3px_0px_#e5b842]">
            <span class="font-poppins text-xl sm:text-2xl font-bold text-[#e5b842] block">5+</span>
            <span class="font-mono text-[10px] text-neutral-400 uppercase">Years Coding</span>
          </div>
          <div class="p-3 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl text-center shadow-[3px_3px_0px_#e5b842]">
            <span class="font-poppins text-xl sm:text-2xl font-bold text-[#e5b842] block">20+</span>
            <span class="font-mono text-[10px] text-neutral-400 uppercase">Apps Shipped</span>
          </div>
          <div class="p-3 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl text-center shadow-[3px_3px_0px_#e5b842]">
            <span class="font-poppins text-xl sm:text-2xl font-bold text-[#e5b842] block">99.9%</span>
            <span class="font-mono text-[10px] text-neutral-400 uppercase">Uptime Built</span>
          </div>
          <div class="p-3 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl text-center shadow-[3px_3px_0px_#e5b842]">
            <span class="font-poppins text-xl sm:text-2xl font-bold text-[#e5b842] block">Edge</span>
            <span class="font-mono text-[10px] text-neutral-400 uppercase">Native Focus</span>
          </div>
        </div>
      </div>

      <!-- ================= VERTICAL NEO-BRUTALIST TIMELINE ================= -->
      <div class="relative pl-6 sm:pl-10 space-y-10">
        
        <!-- Continuous Glowing Yellow Timeline Guide Line -->
        <div class="absolute left-2 sm:left-4 top-4 bottom-4 w-1 bg-gradient-to-b from-[#e5b842] via-[#e5b842] to-[#2e3545] rounded-full"></div>

        {careerItems.map((item, index) => (
          <div data-reveal data-reveal-delay={index * 80} class="relative group">
            
            <!-- Timeline Node Indicator -->
            <div class="absolute -left-[27px] sm:-left-[39px] top-6 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#14171f] border-2 sm:border-[2.5px] border-[#e5b842] flex items-center justify-center font-mono text-[11px] font-bold text-[#e5b842] shadow-[0_0_10px_rgba(229,184,66,0.35)] group-hover:bg-[#e5b842] group-hover:text-[#0d0f14] transition-colors z-20">
              {String(index + 1).padStart(2, '0')}
            </div>

            <!-- Milestone Card with Solid Block Shadow -->
            <div class="p-6 sm:p-8 bg-[#1a1e28] border-2 sm:border-[3px] border-[#2e3545] rounded-2xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200 space-y-4">
              
              <!-- Card Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#2e3545] pb-4">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="card-heading text-lg sm:text-xl text-[#e6e8ec]">
                      {item.data.role}
                    </h2>
                    {item.data.current && (
                      <span class="px-2 py-0.5 bg-[#e5b842] text-[#0d0f14] font-mono font-bold text-[9px] rounded shadow-[1px_1px_0px_#ffffff]">
                        CURRENT
                      </span>
                    )}
                    <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-neutral-300 font-mono text-[10px] rounded">
                      {item.data.type}
                    </span>
                  </div>

                  <p class="font-mono text-xs text-[#e5b842] mt-1 flex items-center gap-2">
                    {item.data.companyUrl ? (
                      <a href={item.data.companyUrl} target="_blank" rel="noopener noreferrer" class="hover:underline font-bold">
                        {item.data.company} ↗
                      </a>
                    ) : (
                      <span class="font-bold">{item.data.company}</span>
                    )}
                    <span>•</span>
                    <span class="text-neutral-400">{item.data.location}</span>
                  </p>
                </div>

                <!-- Date Range Badge with Block Shadow -->
                <div class="font-mono text-xs text-[#e5b842] self-start sm:self-auto shrink-0">
                  <span class="px-3 py-1 bg-[#14171f] border border-[#2e3545] rounded-lg shadow-[2px_2px_0px_#e5b842]">
                    {item.data.startDate} — {item.data.endDate || 'Present'}
                  </span>
                </div>
              </div>

              <!-- Summary Description -->
              <p class="text-xs sm:text-sm font-mono text-neutral-300 leading-relaxed">
                {item.data.summary}
              </p>

              <!-- Key Achievements / Highlights -->
              {item.data.highlights && item.data.highlights.length > 0 && (
                <div class="space-y-1.5 pt-2">
                  <span class="font-mono text-[11px] text-neutral-400 uppercase tracking-wider block">// Key Achievements &amp; Impact</span>
                  <ul class="space-y-1.5 font-mono text-xs text-neutral-200">
                    {item.data.highlights.map((highlight) => (
                      <li class="flex items-start gap-2">
                        <span class="text-[#e5b842] mt-0.5">✔</span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Skills & Technologies Used -->
              {item.data.skills && item.data.skills.length > 0 && (
                <div class="pt-3 border-t border-[#2e3545] flex flex-wrap gap-1.5">
                  {item.data.skills.map((skill) => (
                    <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-neutral-300 rounded text-[10px] font-mono shadow-[1px_1px_0px_#e5b842]">
                      {skill}
                    </span>
                  ))}
                </div>
              )}

            </div>
          </div>
        ))}

      </div>

    </div>
  </div>
</Layout>
