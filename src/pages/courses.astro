---
// src/pages/courses.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SEOJsonLd from '../components/SEOJsonLd.astro';

const allCourses = await getCollection('courses');

const stats = [
  { value: "48+", label: "ISI B.Stat / B.Math Cracks (2024-2025)" },
  { value: "99.8+", label: "Highest JEE Advanced Math Percentile" },
  { value: "120+", label: "INMO & IOQM Selections Globally" },
  { value: "100%", label: "Rigorous First-Principles Teaching Vow" }
];
---

<Layout 
  title="Interactive Courses & Cohorts - deMath"
  description="Master mathematics with first-principles learning. Premium live cohorts and self-paced programs for JEE Advanced, ISI/CMI entrances, and Math Olympiads."
>
  <SEOJsonLd
    type="course"
    title="Master Real Mathematics — Live Cohorts & Courses"
    description="Rigorous first-principles live mathematics cohorts for JEE Advanced, ISI/CMI entrances, and Olympiads by Saad Hassan."
    url={Astro.url.href}
    author="Saad Hassan"
    courseDetails={{
      instructor: "Saad Hassan",
      level: "Olympiad & Advanced Entrance",
      duration: "Multi-week intensive cohort",
      category: "Advanced Mathematics"
    }}
    breadcrumbs={[
      { name: 'Home', item: 'https://saadhassan.in/' },
      { name: 'Live Classes & Cohorts', item: Astro.url.href }
    ]}
  />


  <div class="min-h-screen bg-[#f5f5f2] text-[#2a2a2a] relative overflow-hidden font-sans selection:bg-[#ebef70] py-12 sm:py-16">
    <!-- Blueprint Paper Grid Lines -->
    <div class="absolute inset-0 z-0 opacity-[0.04] pointer-events-none"
         style="background-size: 24px 24px; background-image: linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px);">
    </div>

    <main class="max-w-7xl px-4 mx-auto sm:px-6 relative z-10 space-y-12">

    <!-- Hero Section -->
    <section class="text-center space-y-6">
      <div class="inline-flex items-center gap-x-2 px-2.5 sm:px-4 py-1 sm:py-1.5 border-2 border-dashed border-[#2a2a2a] rounded-full bg-white shadow-[2px_2px_0px_#2a2a2a]">
        <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-indigo-600 rounded-full animate-pulse"></div>
        <span class="text-[10px] sm:text-xs font-mono font-bold text-[#2a2a2a]">Join 10,000+ mathematics enthusiasts today</span>
      </div>


      <h1 class="font-sketch hero-heading font-semibold text-[#2a2a2a] max-w-4xl mx-auto leading-none">
        Master Real Mathematics. <br />
        <span class="underline decoration-[#ebef70] decoration-8">From First Principles.</span>
      </h1>

      <p class="text-neutral-600 font-mono text-sm max-w-2xl mx-auto leading-relaxed">
        Stop memorizing templates. Master active visualization and rigorous proof-writing. Hand-crafted courses for Olympiads, JEE Advanced, and ISI/CMI entrances.
      </p>

      <div class="flex items-center justify-center gap-4 pt-2">
        <a 
          href="#cohorts-grid"
          class="px-6 py-3 rounded-xl bg-[#ebef70] border-[3px] border-[#2a2a2a] text-sm font-mono font-bold text-[#2a2a2a] shadow-[4px_4px_0px_#2a2a2a] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_#2a2a2a] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all"
        >
          EXPLORE COHORTS ↓
        </a>
      </div>
    </section>

    <!-- Stats Banner -->
    <section class="relative z-10">
      <div data-reveal class="bg-[#2a2a2a] rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 shadow-[5px_5px_0px_0px_#ebef70] sm:shadow-[8px_8px_0px_0px_#ebef70] border-2 sm:border-[3px] border-[#2a2a2a]">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 divide-y md:divide-y-0 md:divide-x divide-neutral-600">
          {stats.map((stat, idx) => (
            <div class={`flex flex-col items-center text-center px-2 sm:px-4 ${idx > 0 && idx % 2 === 0 ? 'pt-4 md:pt-0' : ''} ${idx >= 2 ? 'pt-4 md:pt-0' : ''}`}>
              <span class="text-2xl sm:text-4xl font-sketch font-bold text-[#ebef70] tracking-wide">{stat.value}</span>
              <span class="text-[10px] sm:text-xs font-mono font-bold text-neutral-300 mt-1 sm:mt-2">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why deMath / Philosophy Section -->
    <section class="relative z-10">
      <div data-reveal class="text-center space-y-2 mb-6 sm:mb-8">
        <h2 class="font-sketch section-heading font-semibold text-[#2a2a2a]">Why deMath?</h2>
        <p class="text-xs font-mono font-bold text-neutral-500 max-w-lg mx-auto uppercase tracking-wider">Our most comprehensive and rigorous learning experiences</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-8">
        <!-- Card 1: First-Principles Rigor -->
        <div data-reveal data-reveal-delay="0" class="p-5 sm:p-8 bg-white border-2 sm:border-[3px] border-[#2a2a2a] rounded-xl sm:rounded-2xl shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[6px_6px_0px_0px_#2a2a2a] flex flex-col justify-between space-y-4 sm:space-y-6 animate-fade-up delay-75">
          <div class="space-y-3 sm:space-y-4">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-neutral-100 border-2 border-[#2a2a2a] flex items-center justify-center font-mono font-black text-base sm:text-lg text-indigo-600 shadow-[2px_2px_0px_#2a2a2a]">
              ∀
            </div>
            <h3 class="card-heading font-bold text-[#2a2a2a]">First-Principles Rigor</h3>
            <p class="text-xs text-neutral-500 font-sans font-medium leading-relaxed">
              We do not believe in rote memorization or calculation tricks. Every formula is derived from the ground up, and every theorem is proved from absolute first principles to cultivate pure mathematical intuition.
            </p>
          </div>
        </div>

        <!-- Card 2: Learn by Proving (Highlighted Center Card) -->
        <div data-reveal data-reveal-delay="120" class="p-5 sm:p-8 bg-[#2a2a2a] text-white border-2 sm:border-[3px] border-[#2a2a2a] rounded-xl sm:rounded-2xl shadow-[5px_5px_0px_0px_#ebef70] sm:shadow-[8px_8px_0px_0px_#ebef70] flex flex-col justify-between space-y-4 sm:space-y-6 relative md:translate-y-0 animate-fade-up delay-150">
          <div class="absolute -top-3.5 right-4 sm:right-6 px-2.5 sm:px-3 py-0.5 border-2 border-[#2a2a2a] bg-[#ebef70] text-[10px] sm:text-xs font-mono font-bold text-[#2a2a2a] rounded shadow-[2px_2px_0px_#2a2a2a] uppercase tracking-wider">
             Core Focus
          </div>
          <div class="space-y-3 sm:space-y-4">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-[#ebef70] border-2 border-[#2a2a2a] flex items-center justify-center font-mono font-black text-base sm:text-lg text-[#2a2a2a] shadow-[2px_2px_0px_#2a2a2a]">
              ■
            </div>
            <h3 class="card-heading font-bold text-[#ebef70]">Active Proof Writing</h3>
            <p class="text-xs text-neutral-300 font-sans font-medium leading-relaxed">
              True mathematics is done, not watched. Students engage in active visualization, construct rigorous mathematical proofs, and submit them for direct evaluation by experienced educators.
            </p>
          </div>
        </div>

        <!-- Card 3: Olympiad-Ready Pedagogy -->
        <div data-reveal data-reveal-delay="240" class="p-5 sm:p-8 bg-white border-2 sm:border-[3px] border-[#2a2a2a] rounded-xl sm:rounded-2xl shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[6px_6px_0px_0px_#2a2a2a] flex flex-col justify-between space-y-4 sm:space-y-6 animate-fade-up delay-200">
          <div class="space-y-3 sm:space-y-4">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-neutral-100 border-2 border-[#2a2a2a] flex items-center justify-center font-mono font-black text-base sm:text-lg text-indigo-600 shadow-[2px_2px_0px_#2a2a2a]">
              ∞
            </div>
            <h3 class="card-heading font-bold text-[#2a2a2a]">Proven Olympiad Pedagogy</h3>
            <p class="text-xs text-neutral-500 font-sans font-medium leading-relaxed">
              Learn from Saad Hassan, an accomplished educator with 8+ years as National Head of Olympiad Division at VMC and credentials from North Carolina State University. Rigorous prep built for elite contest success.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Learn With Saad & Live Pedagogy Showcase -->
    <section id="cohorts-grid" class="relative z-10 space-y-8 sm:space-y-12">
      
      <!-- Section Header -->
      <div class="border-b-[3px] border-[#2a2a2a] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-x-2 px-3 py-1 border-2 border-[#2a2a2a] rounded-full bg-[#ebef70] font-mono text-[10px] font-bold tracking-wider shadow-[2px_2px_0px_#2a2a2a] mb-3">
            <span class="w-2 h-2 rounded-full bg-[#2a2a2a] animate-ping"></span>
            <span>Personal Mentorship & Live Masterclasses</span>
          </div>
          <h2 class="font-sketch section-heading font-semibold text-[#2a2a2a] leading-none">
            Learn with Saad
          </h2>
          <p class="text-xs sm:text-sm font-mono font-bold text-neutral-500 mt-2">
            Step into the classroom. Experience first-principles problem-solving in action.
          </p>
        </div>
        <span class="text-xs font-mono font-black text-indigo-600 uppercase bg-indigo-50 border-2 border-[#2a2a2a] px-3 py-1.5 rounded-lg shadow-[2px_2px_0px_#2a2a2a] self-start sm:self-auto">
          2026-2027 Cohorts Open
        </span>
      </div>

      <!-- Hero Video & Personal Branding Card (Rich Black Aesthetic) -->
      <div data-reveal class="bg-[#2a2a2a] text-white border-2 sm:border-[3px] border-[#2a2a2a] rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 shadow-[5px_5px_0px_0px_#ebef70] sm:shadow-[8px_8px_0px_0px_#ebef70] grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-center overflow-hidden">
        
        <!-- Left: Saad Hassan Identity & Hexagon Portrait -->
        <div class="lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left space-y-4 sm:space-y-5">
          
          <!-- Hexagon Frame -->
          <div class="relative w-44 h-40 sm:w-60 sm:h-56 flex items-center justify-center select-none group">
            <svg viewBox="0 0 220 200" class="w-full h-full filter drop-shadow-[4px_4px_0px_#000000] sm:drop-shadow-[5px_5px_0px_#000000] transition-transform duration-300 group-hover:scale-[1.02]">
              <polygon 
                points="55,10 165,10 212,100 165,190 55,190 8,100" 
                fill="#ebef70" 
                stroke="#ffffff" 
                stroke-width="5" 
                stroke-linejoin="round" 
              />
            </svg>

            <img 
              src="/portrait.png" 
              alt="Saad Hassan" 
              class="absolute bottom-3 w-36 sm:w-48 h-auto max-h-[96%] object-contain z-10 filter drop-shadow-[0px_4px_10px_rgba(0,0,0,0.35)] transition-transform duration-300 group-hover:scale-105"
              loading="eager"
            />

            <span class="absolute bottom-1 right-2 z-20 px-2 sm:px-2.5 py-0.5 bg-white text-[#2a2a2a] border-2 border-[#2a2a2a] rounded-full font-mono text-[9px] font-black uppercase tracking-wider shadow-[2px_2px_0px_#000000]">
              Master Mentor
            </span>
          </div>

          <!-- Bio & Core Credentials -->
          <div class="space-y-1.5 sm:space-y-2">
            <h3 class="hero-heading font-semibold text-white tracking-tight">Saad Hassan</h3>
            <span class="inline-block px-3 py-0.5 bg-[#ebef70] text-[#2a2a2a] text-[11px] font-mono font-bold rounded">
              Renowned Educator & Author
            </span>
          </div>

          <p class="text-xs sm:text-sm text-neutral-300 font-medium leading-relaxed max-w-md">
            "We do not teach mechanical tricks or memorized shortcuts. Every theorem is proved, and every insight is derived from absolute first principles."
          </p>

          <!-- Credential Badges -->
          <div class="w-full pt-1 flex flex-col gap-2 font-mono text-[10px] sm:text-[11px] text-left">
            <div class="p-2 sm:p-2.5 bg-white/5 border border-white/15 rounded-lg flex items-center justify-between">
              <span class="font-bold text-white">Ex-Head of Olympiads</span>
              <span class="text-neutral-400 text-[9px] sm:text-[10px]">Vidyamandir Classes (VMC)</span>
            </div>
            <div class="p-2 sm:p-2.5 bg-white/5 border border-white/15 rounded-lg flex items-center justify-between">
              <span class="font-bold text-white">Mentor and Planner</span>
              <span class="text-neutral-400 text-[9px] sm:text-[10px]">Centre of Excellence</span>
            </div>

            <div class="p-2 sm:p-2.5 bg-[#ebef70]/10 border border-[#ebef70]/30 rounded-lg flex items-center justify-between">
              <span class="font-bold text-[#ebef70]">Published Author</span>
              <span class="text-neutral-300 text-[9px] sm:text-[10px]">The Olympiad Companion & Books</span>
            </div>
          </div>
        </div>



        <!-- Right: Animated Looping Video Canvas with Feature Overlays -->
        <div class="lg:col-span-7 animate-slide-in-right">
          <div class="relative rounded-xl border-2 sm:border-[3px] border-white/20 overflow-hidden bg-neutral-900 shadow-[4px_4px_0px_0px_#000000] sm:shadow-[6px_6px_0px_0px_#000000] group">
            
            <!-- Video Player (Silently Looping) -->
            <div class="relative w-full aspect-[16/10] sm:aspect-[16/10] bg-black">
              <video 
                src="/videoplayback.mp4" 
                autoplay 
                loop 
                muted 
                playsinline 
                preload="metadata"
                class="w-full h-full object-cover opacity-90 transition-transform duration-500 group-hover:scale-[1.02]"
              >
              </video>
              
              <!-- Subtle Bottom Fade (Clear at Top/Center to view Teaching Whiteboard) -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none"></div>

              <!-- Animated Sliding Feature Ticker (Unobtrusive & Clean) -->
              <div class="absolute bottom-3 left-3 right-3 z-10 pointer-events-none">
                <div class="bg-[#181818]/90 backdrop-blur-md border border-white/20 rounded-xl p-2.5 sm:p-3 shadow-xl overflow-hidden">
                  <div id="video-feature-wrapper" class="transition-all duration-300 transform translate-y-0 opacity-100 flex items-center gap-3">
                    <div id="video-feature-num" class="px-2 py-0.5 bg-[#ebef70] text-[#2a2a2a] rounded font-mono text-[10px] font-black shrink-0 shadow-[1px_1px_0px_#000]">
                      01 / 04
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 id="video-feature-title" class="text-white font-mono text-xs sm:text-sm font-bold tracking-tight truncate">
                        Learning from First Principles
                      </h4>
                      <p id="video-feature-desc" class="text-neutral-300 text-[10px] sm:text-xs font-sans font-medium truncate">
                        No mechanical tricks or formula memorization. Discover how to think mathematically.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <!-- Cohorts Grid Header -->
      <div data-reveal class="pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-dashed border-neutral-300 pb-2">
        <h3 class="font-sketch text-2xl sm:text-3xl font-bold text-[#2a2a2a]">
          Comprehensive Cohorts (2026-2027)
        </h3>
        <span class="font-mono text-xs font-bold text-neutral-500">
          Showing {allCourses.length} Structured Cohorts
        </span>
      </div>

      <!-- Cohorts Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {allCourses.map((course, idx) => (
          <div data-reveal data-reveal-delay={idx * 100} class="bg-white border-2 sm:border-[3px] border-[#2a2a2a] rounded-xl sm:rounded-2xl shadow-[5px_5px_0px_0px_#2a2a2a] sm:shadow-[8px_8px_0px_0px_#2a2a2a] hover:shadow-[7px_7px_0px_0px_#2a2a2a] sm:hover:shadow-[10px_10px_0px_0px_#2a2a2a] hover:-translate-x-[1px] hover:-translate-y-[1px] sm:hover:-translate-x-[2px] sm:hover:-translate-y-[2px] transition-all flex flex-col justify-between overflow-hidden group">
            <div>
              {/* Course Emblem Header */}
              {course.data.image ? (
                <div class="h-40 sm:h-48 border-b-2 sm:border-b-[3px] border-[#2a2a2a] relative overflow-hidden bg-neutral-100 flex items-center justify-center">
                  <img 
                    src={course.data.image} 
                    alt={course.data.title}
                    class="w-full h-full object-cover" 
                  />
                  <span class={`absolute top-3 left-3 sm:top-4 sm:left-4 px-2 py-0.5 border-2 border-[#2a2a2a] ${course.data.badgeColor || 'bg-[#ebef70]'} text-[9px] font-mono font-black rounded shadow-[1px_1px_0px_#2a2a2a]`}>
                    {course.data.tag}
                  </span>
                </div>
              ) : (
                <div class="h-40 sm:h-48 border-b-2 sm:border-b-[3px] border-[#2a2a2a] relative overflow-hidden bg-neutral-100 flex items-center justify-center select-none"
                     style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(0,0,0,0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.03) 1px, transparent 1px);">
                  <!-- Subtle geometric circle inside -->
                  <div class="absolute w-36 h-36 rounded-full border border-dashed border-neutral-300 flex items-center justify-center">
                    <div class="absolute w-24 h-24 rounded-full border border-dashed border-neutral-200"></div>
                  </div>
                  <!-- Large course identifier symbol -->
                  <span class="text-5xl sm:text-6xl font-sketch font-bold text-neutral-400 z-10 select-none">{course.data.emblem || '∫'}</span>
                  <!-- Top Badge tag inside image -->
                  <span class={`absolute top-3 left-3 sm:top-4 sm:left-4 px-2 py-0.5 border-2 border-[#2a2a2a] ${course.data.badgeColor || 'bg-[#ebef70]'} text-[9px] font-mono font-black rounded shadow-[1px_1px_0px_#2a2a2a]`}>
                    {course.data.tag}
                  </span>
                  <!-- Bottom label inside image -->
                  <span class="absolute bottom-2 right-3 font-mono text-[9px] text-neutral-400 tracking-wider">deMath Education Vault</span>
                </div>
              )}

              <!-- Content Area -->
              <div class="p-4 sm:p-6 md:p-8 space-y-3 sm:space-y-4">
                <h3 class="card-heading font-semibold text-[#2a2a2a] group-hover:text-indigo-600 transition-colors">
                  {course.data.title}
                </h3>
                {course.data.subtitle && (
                  <span class="block text-[11px] sm:text-xs font-mono font-bold text-neutral-500 uppercase tracking-wide">{course.data.subtitle}</span>
                )}
                {course.data.description && (
                  <p class="text-xs text-neutral-600 leading-relaxed font-sans font-medium">
                    {course.data.description}
                  </p>
                )}

                <!-- Features list -->
                {course.data.features && course.data.features.length > 0 && (
                  <div class="space-y-2 pt-2">
                    <span class="block text-[10px] font-mono font-black text-neutral-400 uppercase tracking-widest">Highlights:</span>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {course.data.features.map((feat) => (
                        <li class="flex items-start gap-1.5 text-[10px] sm:text-[11px] font-mono font-bold text-[#2a2a2a]">
                          <span class="text-indigo-600 shrink-0">■</span>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>

            <!-- Pricing & CTA footer -->
            <div class="p-4 sm:p-6 md:p-8 pt-0 border-t border-dashed border-neutral-200 mt-3 sm:mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
              <div class="flex flex-col">
                {course.data.oldPrice && (
                  <span class="text-[10px] font-mono font-bold text-neutral-400 line-through">{course.data.oldPrice}</span>
                )}
                <span class="text-lg sm:text-xl font-mono font-black text-[#2a2a2a]">{course.data.price} <span class="text-[9px] font-mono font-bold text-neutral-400">INR</span></span>
              </div>
              <a
                href={course.data.redirectLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto text-center px-3.5 sm:px-4 py-2 sm:py-2 bg-indigo-50 border-2 border-[#2a2a2a] text-xs font-mono font-bold rounded-lg shadow-[2px_2px_0px_#2a2a2a] hover:bg-[#ebef70] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all shrink-0"
              >
                Explore Course ↗
              </a>
            </div>

          </div>
        ))}
      </div>
    </section>
    </main>
  </div>
</Layout>

<script>
  function setupVideoTicker() {
    const tickerFeatures = [
      {
        num: "01 / 04",
        title: "Learning from First Principles",
        desc: "No formula memorization or template tricks. Discover how to truly think mathematically."
      },
      {
        num: "02 / 04",
        title: "Elite Olympiad & Entrance Prep",
        desc: "Proven contest rigor for IOQM, INMO, ISI B.Math / B.Stat, CMI and JEE Advanced."
      },
      {
        num: "03 / 04",
        title: "Mentorship by Saad Hassan",
        desc: "Author of The Olympiad Companion and former National Head of Olympiads at VMC."
      },
      {
        num: "04 / 04",
        title: "Unseen Problem Intuition",
        desc: "Cultivate the deep intuition to construct rigorous proofs for completely unfamiliar problems."
      }
    ];

    let currentIndex = 0;
    const wrapper = document.getElementById('video-feature-wrapper');
    const numEl = document.getElementById('video-feature-num');
    const titleEl = document.getElementById('video-feature-title');
    const descEl = document.getElementById('video-feature-desc');

    if (!wrapper || !numEl || !titleEl || !descEl) return;

    setInterval(() => {
      // Step 1: Slide & fade out up
      wrapper.classList.remove('translate-y-0', 'opacity-100');
      wrapper.classList.add('-translate-y-3', 'opacity-0');

      setTimeout(() => {
        // Step 2: Update content & reposition below
        currentIndex = (currentIndex + 1) % tickerFeatures.length;
        const current = tickerFeatures[currentIndex];
        numEl.textContent = current.num;
        titleEl.textContent = current.title;
        descEl.textContent = current.desc;

        wrapper.classList.remove('-translate-y-3');
        wrapper.classList.add('translate-y-3');

        // Step 3: Slide & fade in from bottom to neutral
        requestAnimationFrame(() => {
          setTimeout(() => {
            wrapper.classList.remove('translate-y-3', 'opacity-0');
            wrapper.classList.add('translate-y-0', 'opacity-100');
          }, 40);
        });
      }, 300);
    }, 3800);
  }

  setupVideoTicker();
  document.addEventListener('astro:page-load', setupVideoTicker);
</script>

