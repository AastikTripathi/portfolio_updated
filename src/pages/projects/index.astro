---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];
---

<Layout 
  title="Projects Showcase | Aastik Tripathi"
  description="Explore applications, open-source systems, and tools built by Aastik Tripathi."
>
  <SEOJsonLd
    type="website"
    title="Projects Showcase - Aastik Tripathi"
    description="Full portfolio of web applications, tools, and systems."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#0d0f14] text-[#e6e8ec] py-12 sm:py-16">
    <div class="max-w-7xl px-4 mx-auto sm:px-6 space-y-12">

      <!-- Header Banner Frame with Solid Block Shadow -->
      <div class="border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] p-6 sm:p-12 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842]">
        <div class="inline-block px-3 py-1 border-2 border-[#000000] bg-[#e5b842] text-[#0d0f14] font-mono text-[10px] font-bold rounded-full shadow-[3px_3px_0px_#ffffff] mb-4">
          PORTFOLIO DIRECTORY
        </div>
        <h1 class="hero-heading text-[#e6e8ec] mb-3">
          Projects &amp; <span class="text-[#e5b842] underline decoration-[3px] decoration-[#e5b842]">Systems</span>
        </h1>
        <p class="text-xs sm:text-sm font-mono text-neutral-400 max-w-2xl leading-relaxed">
          A collection of software engineering initiatives, distributed services, creative tools, and web applications.
        </p>

        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2 pt-6 mt-6 border-t border-[#2e3545]">
          {categories.map((cat) => (
            <button
              class="px-3 py-1.5 font-mono text-xs font-bold rounded-lg border-2 border-[#2e3545] bg-[#1a1e28] text-neutral-300 hover:border-[#e5b842] hover:text-[#e5b842] hover:shadow-[2px_2px_0px_#e5b842] transition-all"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Projects Grid with Solid Offset Block Shadows -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project, idx) => (
          <div class="p-6 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl sm:rounded-2xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-[#e5b842] rounded text-[10px] font-mono font-bold shadow-[1px_1px_0px_#e5b842]">
                  {project.data.category}
                </span>
                <span class="font-mono text-[10px] text-neutral-400">
                  {project.data.role}
                </span>
              </div>

              <h2 class="card-heading text-[#e6e8ec] hover:text-[#e5b842] transition-colors">
                <a href={`/projects/${project.id}`}>
                  {project.data.title}
                </a>
              </h2>

              <p class="text-xs font-mono text-neutral-400 leading-relaxed">
                {project.data.description}
              </p>

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1.5 pt-2">
                {project.data.techStack.map((tech) => (
                  <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-neutral-300 rounded text-[10px] font-mono">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-[#2e3545] flex items-center justify-between font-mono text-xs font-bold">
              <a href={`/projects/${project.id}`} class="text-[#e5b842] hover:underline flex items-center gap-1">
                Overview →
              </a>
              <div class="flex items-center gap-3">
                {project.data.githubUrl && (
                  <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-[#e6e8ec]">
                    GitHub ↗
                  </a>
                )}
                {project.data.liveUrl && (
                  <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-[#e5b842]">
                    Demo ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>
