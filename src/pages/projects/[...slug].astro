---
// src/pages/projects/[...slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Projects - Aastik Tripathi`}
  description={project.data.description}
>
  <SEOJsonLd
    type="article"
    title={project.data.title}
    description={project.data.description}
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#0d0f14] text-[#e6e8ec] py-12 sm:py-16">
    <div class="max-w-4xl px-4 mx-auto sm:px-6 space-y-8">

      <!-- Back link -->
      <a href="/projects" class="inline-flex items-center gap-2 font-mono text-xs text-[#e5b842] hover:underline font-bold">
        ← BACK TO ALL PROJECTS
      </a>

      <!-- Project Header Card with Solid Block Shadow -->
      <div class="p-6 sm:p-10 bg-[#14171f] border-2 sm:border-[3px] border-[#2e3545] rounded-2xl sm:rounded-3xl shadow-[6px_6px_0px_0px_#e5b842] space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#2e3545] pb-4">
          <span class="px-3 py-1 bg-[#0d0f14] border border-[#2e3545] text-[#e5b842] rounded font-mono text-xs font-bold shadow-[2px_2px_0px_#e5b842]">
            {project.data.category}
          </span>
          <span class="font-mono text-xs text-neutral-400">
            Role: <strong class="text-neutral-200">{project.data.role}</strong>
          </span>
        </div>

        <h1 class="hero-heading text-[#e6e8ec]">
          {project.data.title}
        </h1>

        <p class="text-sm sm:text-base font-mono text-neutral-300 leading-relaxed">
          {project.data.description}
        </p>

        <!-- Tech Stack -->
        <div class="space-y-2">
          <span class="font-mono text-xs text-neutral-400 uppercase tracking-wider block">// Technologies Used</span>
          <div class="flex flex-wrap gap-2">
            {project.data.techStack.map((tech) => (
              <span class="px-2.5 py-1 bg-[#1a1e28] border border-[#2e3545] text-neutral-200 font-mono text-xs rounded-md shadow-[2px_2px_0px_#0d0f14]">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Action Links with Tactile Push -->
        <div class="flex flex-wrap gap-4 pt-4 border-t border-[#2e3545]">
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 font-mono font-bold text-xs uppercase border-2 border-[#000000] rounded-lg bg-[#e5b842] text-[#0d0f14] shadow-[3px_3px_0px_#ffffff] hover:translate-x-[1px] hover:translate-y-[1px] active:translate-x-[2px] active:translate-y-[2px] transition-all"
            >
              LAUNCH LIVE DEMO ↗
            </a>
          )}
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 font-mono font-bold text-xs uppercase border-2 border-[#2e3545] rounded-lg bg-[#1a1e28] text-neutral-200 hover:border-[#e5b842] hover:text-[#e5b842] shadow-[3px_3px_0px_#e5b842] hover:translate-x-[1px] hover:translate-y-[1px] active:translate-x-[2px] active:translate-y-[2px] transition-all"
            >
              VIEW SOURCE CODE ↗
            </a>
          )}
        </div>
      </div>

      <!-- Markdown Content Section with Solid Shadow -->
      <div class="p-6 sm:p-10 bg-[#14171f] border-2 sm:border-[3px] border-[#2e3545] rounded-2xl sm:rounded-3xl shadow-[5px_5px_0px_0px_#e5b842]">
        <article class="markdown-content">
          <Content />
        </article>
      </div>

    </div>
  </div>
</Layout>
