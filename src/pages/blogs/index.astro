---
// src/pages/blogs/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

const blogs = (await getCollection('blogs')).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<Layout 
  title="Technical Blog | Aastik Tripathi"
  description="Articles on web architecture, distributed systems, and modern UI engineering."
>
  <SEOJsonLd
    type="website"
    title="Technical Blog - Aastik Tripathi"
    description="Writings on full-stack web development and software architecture."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#0d0f14] text-[#e6e8ec] py-12 sm:py-16">
    <div class="max-w-5xl px-4 mx-auto sm:px-6 space-y-12">

      <!-- Header Banner Frame with Solid Block Shadow -->
      <div class="border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] p-6 sm:p-12 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842]">
        <div class="inline-block px-3 py-1 border-2 border-[#000000] bg-[#e5b842] text-[#0d0f14] font-mono text-[10px] font-bold rounded-full shadow-[3px_3px_0px_#ffffff] mb-4">
          TECHNICAL WRITINGS
        </div>
        <h1 class="hero-heading text-[#e6e8ec] mb-3">
          Articles &amp; <span class="text-[#e5b842] underline decoration-[3px] decoration-[#e5b842]">Notes</span>
        </h1>
        <p class="text-xs sm:text-sm font-mono text-neutral-400 max-w-2xl leading-relaxed">
          Reflections, tutorials, and practical insights on modern software engineering, edge architectures, and interface design.
        </p>
      </div>

      <!-- Blog Articles List with Solid Block Shadows -->
      <div class="space-y-6">
        {blogs.map((blog, idx) => (
          <article class="p-6 sm:p-8 bg-[#1a1e28] border-2 sm:border-[3px] border-[#2e3545] rounded-2xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
              <div class="space-y-3 max-w-2xl">
                <div class="flex items-center gap-3 font-mono text-xs text-neutral-400">
                  <span>{new Date(blog.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <span>•</span>
                  <span class="text-[#e5b842] font-bold">{blog.data.readingTime}</span>
                </div>

                <h2 class="card-heading text-xl text-[#e6e8ec] hover:text-[#e5b842] transition-colors">
                  <a href={`/blogs/${blog.id}`}>
                    {blog.data.title}
                  </a>
                </h2>

                <p class="text-xs sm:text-sm font-mono text-neutral-300 leading-relaxed">
                  {blog.data.summary}
                </p>

                <!-- Tags -->
                {blog.data.tags && blog.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {blog.data.tags.map((tag) => (
                      <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-neutral-300 font-mono text-[10px] rounded shadow-[1px_1px_0px_#e5b842]">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Read Link with Tactile Border & Shadow -->
              <div class="shrink-0 pt-2 sm:pt-0">
                <a
                  href={`/blogs/${blog.id}`}
                  class="inline-flex items-center gap-1.5 px-4 py-2 font-mono font-bold text-xs uppercase border-2 border-[#2e3545] bg-[#14171f] text-[#e5b842] rounded-lg shadow-[2px_2px_0px_#e5b842] hover:border-[#e5b842] hover:shadow-[3px_3px_0px_#e5b842] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
                >
                  Read Post →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</Layout>
