---
// src/pages/category/[category].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allCategories = await getCollection('categories');
  const allProblems = await getCollection('problems');

  return allCategories.map(cat => {
    const cleanCategoryId = cat.id.replace(/\.(yaml|yml)$/, '');

    // Filter problems belonging strictly to this category
    const matchingProblems = allProblems.filter(p => {
      const rawCat = p.data.category;
      const problemCatId = typeof rawCat === 'object' && rawCat !== null
        ? rawCat.id.replace(/\.(yaml|yml)$/, '')
        : String(rawCat || '').replace(/\.(yaml|yml)$/, '');
      return problemCatId === cleanCategoryId;
    });

    return {
      params: { category: cleanCategoryId },
      props: { category: cat, problems: matchingProblems, allCategories },
    };
  });
}

const { category, problems, allCategories } = Astro.props;
---

<Layout 
  title={`${category.data.name} Math Problems & Proofs Archive // deMath`}
  description={`Browse contest problems, step-by-step solutions, and proofs in ${category.data.name}. Competition math archive for JEE, ISI, CMI, Putnam, IMO, HMMT, RMO, and INMO.`}
>
  <div class="min-h-screen bg-[#f5f5f2] relative overflow-hidden font-sans pt-12">

    <!-- Blueprint Grid Effect -->
    <div class="absolute inset-0 z-0 opacity-[0.04] pointer-events-none"
         style="background-size: 24px 24px; background-image: linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px);">
    </div>

    <main class="max-w-7xl px-4 mx-auto sm:px-6 relative z-10 grid grid-cols-1 lg:grid-cols-4 gap-8 pb-24">

      <!-- LEFT COLUMN: Disciplines Navigation Sidebar -->
      <div class="lg:col-span-1 space-y-6">
        <div class="p-5 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] space-y-3">
          <h4 class="font-sketch text-lg font-bold border-b-2 border-[#2a2a2a] pb-1">
            Topics
          </h4>
          <div class="flex flex-col gap-2">
            {allCategories.map((c) => {
              const cleanId = c.id.replace(/\.(yaml|yml)$/, '');
              const isActive = cleanId === category.id.replace(/\.(yaml|yml)$/, '');
              return (
                <a
                  href={`/category/${cleanId}`}
                  class={`px-3 py-2 rounded-lg text-xs font-mono font-bold border-2 transition-all block text-left ${
                    isActive
                      ? 'bg-[#ebef70] border-[#2a2a2a] shadow-[2px_2px_0px_0px_#2a2a2a]'
                      : 'bg-neutral-50 border-neutral-200 text-[#2a2a2a] hover:border-[#2a2a2a] hover:bg-[#ebef70]/10'
                  }`}
                >
                  {c.data.name} {isActive ? '•' : '→'}
                </a>
              );
            })}
          </div>
        </div>

        <a href="/problems" class="inline-block text-xs font-mono font-bold text-neutral-500 underline hover:text-[#2a2a2a]">
          ← Back to Archives
        </a>
      </div>

      <!-- RIGHT COLUMN: Isolated Cards Grid -->
      <div class="lg:col-span-3 space-y-6">
        <div class="border-b-[3px] border-[#2a2a2a] pb-4">
          <h1 class="font-sketch hero-heading font-semibold text-[#2a2a2a]">
            {category.data.name} Archives
          </h1>
          <p class="text-xs font-mono font-bold text-neutral-500 mt-1">
            Showing {problems.length} problem{problems.length === 1 ? '' : 's'} in this topic.
          </p>
        </div>

        <div class="space-y-6">
          {problems.map((problem) => (
            <div class="group block p-6 bg-white border-[3px] border-[#2a2a2a] rounded-2xl shadow-[6px_6px_0px_0px_#2a2a2a] relative overflow-hidden">
              <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <span class="px-2 py-0.5 border-2 border-[#2a2a2a] bg-[#ebef70] text-[10px] font-mono font-black rounded">
                  {problem.data.superCategory || 'Olympiad'}
                </span>
                <span class="text-xs text-neutral-400 font-mono">
                  {problem.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>

              <h3 class="text-2xl font-black text-[#2a2a2a] mb-2">
                {problem.data.title}
              </h3>

              <div class="flex justify-between items-center pt-2 border-t border-dashed border-neutral-200 mt-4">
                <a href={`/problems/${problem.id}`} class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-wider text-indigo-600 underline">
                  View Proof & Solution →
                </a>
              </div>
            </div>
          ))}

          {problems.length === 0 && (
            <div class="p-8 border-[3px] border-dashed border-neutral-300 rounded-2xl text-center font-mono text-xs text-neutral-400">
              No proof files linked to this category yet. Create one via Keystatic!
            </div>
          )}
        </div>
      </div>
    </main>
  </div>
</Layout>
