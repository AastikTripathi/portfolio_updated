---
// src/pages/articles/[...slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

import Embed from '../../components/Embed.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(art => ({
    params: { slug: art.id },
    props: { article: art },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

function buildEmbedHtml(tagType: string, id: string, query: string, url: string, title: string): string {
  if (tagType === 'youtube') {
    const ytId = id || url;
    return `<div class="my-6 bg-white border-[3px] border-[#2a2a2a] rounded-xl p-3 shadow-[6px_6px_0px_0px_#2a2a2a]"><div class="flex items-center justify-between pb-2 mb-2 border-b-2 border-dashed border-neutral-200 font-mono text-xs font-bold text-[#2a2a2a]"><span class="px-2 py-0.5 bg-red-100 border border-red-300 text-red-700 rounded text-[10px] font-black uppercase">Video: ${title}</span></div><div class="relative w-full overflow-hidden rounded-lg border-2 border-[#2a2a2a] bg-black" style="padding-top:56.25%"><iframe src="https://www.youtube-nocookie.com/embed/${ytId}" title="${title}" class="absolute top-0 left-0 w-full h-full" allowfullscreen loading="lazy"></iframe></div></div>`;
  } else if (tagType === 'wolfram') {
    const src = id ? `https://www.wolframcloud.com/obj/demonstrations/${id}?_embed=1` : `https://www.wolframalpha.com/widget/input/?input=${encodeURIComponent(query)}&output=popup`;
    const directLink = id ? `https://demonstrations.wolfram.com/${id}/` : '#';
    return `<div class="my-6 bg-white border-[3px] border-[#2a2a2a] rounded-xl p-3 shadow-[6px_6px_0px_0px_#2a2a2a]"><div class="flex items-center justify-between pb-2 mb-2 border-b-2 border-dashed border-neutral-200 font-mono text-xs font-bold text-[#2a2a2a]"><span class="px-2 py-0.5 bg-amber-100 border border-amber-300 text-amber-800 rounded text-[10px] font-black uppercase">Wolfram Demo: ${title}</span></div><div class="w-full overflow-hidden rounded-lg border-2 border-[#2a2a2a] bg-neutral-50 p-2"><iframe src="${src}" title="${title}" class="w-full h-[500px] border-0 bg-white" loading="lazy"></iframe><div class="pt-2 text-center"><a href="${directLink}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-mono font-bold text-indigo-600 hover:underline">Open original Wolfram Demonstration ↗</a></div></div></div>`;
  } else if (tagType === 'geogebra') {
    return `<div class="my-6 bg-white border-[3px] border-[#2a2a2a] rounded-xl p-3 shadow-[6px_6px_0px_0px_#2a2a2a]"><div class="flex items-center justify-between pb-2 mb-2 border-b-2 border-dashed border-neutral-200 font-mono text-xs font-bold text-[#2a2a2a]"><span class="px-2 py-0.5 bg-sky-100 border border-sky-300 text-sky-800 rounded text-[10px] font-black uppercase">GeoGebra: ${title}</span></div><div class="w-full overflow-hidden rounded-lg border-2 border-[#2a2a2a] bg-white"><iframe src="https://www.geogebra.org/material/iframe/id/${id}/width/800/height/500/border/888888/sfsb/true/smb/false/stb/false/stbh/false/ai/true/asb/false/sri/true/rc/false/ld/false/sdz/true/ctl/false" title="${title}" class="w-full h-[450px] border-0" loading="lazy"></iframe></div></div>`;
  } else if (tagType === 'audio') {
    const targetUrl = url || id;
    let embedInner = '';
    if (targetUrl.includes('spotify.com')) {
      let spotifyEmbedUrl = targetUrl;
      if (!targetUrl.includes('spotify.com/embed/')) {
        spotifyEmbedUrl = targetUrl
          .replace('spotify.com/episode/', 'spotify.com/embed/episode/')
          .replace('spotify.com/track/', 'spotify.com/embed/track/')
          .replace('spotify.com/show/', 'spotify.com/embed/show/')
          .replace('spotify.com/album/', 'spotify.com/embed/album/');
      }
      const isVideo = spotifyEmbedUrl.includes('/video');
      const frameHeight = isVideo ? '351' : '152';
      embedInner = `<iframe src="${spotifyEmbedUrl}" width="100%" height="${frameHeight}" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" class="rounded-md"></iframe>`;
    } else if (targetUrl.includes('soundcloud.com')) {
      embedInner = `<iframe width="100%" height="166" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url=${encodeURIComponent(targetUrl)}&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true" loading="lazy" class="rounded-md"></iframe>`;
    } else {
      embedInner = `<audio controls class="w-full"><source src="${targetUrl}" /></audio>`;
    }
    return `<div class="my-6 bg-white border-[3px] border-[#2a2a2a] rounded-xl p-3 shadow-[6px_6px_0px_0px_#2a2a2a]"><div class="flex items-center justify-between pb-2 mb-2 border-b-2 border-dashed border-neutral-200 font-mono text-xs font-bold text-[#2a2a2a]"><span class="px-2 py-0.5 bg-emerald-100 border border-emerald-300 text-emerald-800 rounded text-[10px] font-black uppercase">Audio: ${title}</span></div>${embedInner}</div>`;
  }
  return '';
}

function buildTikzHtml(rawCode: string, caption?: string): string {
  let cleanCode = rawCode.trim();

  // Convert single-line string newline escapes (\n) into real linebreaks while protecting TeX control sequences like \node
  cleanCode = cleanCode.replace(/\\n(?!(?:ode|ew|umber|ewline)\b)/g, '\n');

  // Fix double-escaped LaTeX dots commands (e.g. \\vdots -> \vdots, \\cdots -> \cdots)
  cleanCode = cleanCode
    .replaceAll('\\\\vdots', '\\vdots')
    .replaceAll('\\\\cdots', '\\cdots')
    .replaceAll('\\\\ldots', '\\ldots')
    .replaceAll('\\\\ddots', '\\ddots');

  // Strip LaTeX comments (% comment) so single-line collapsing never comments out TeX blocks
  cleanCode = cleanCode
    .split('\n')
    .map(line => line.replace(/%.*$/, ''))
    .filter(line => line.trim().length > 0)
    .join('\n');

  // TikZJax loads only \usepackage{tikz} — >=stealth needs the arrows library.
  // Strip it to avoid a TeX error that corrupts node y-coordinates.
  cleanCode = cleanCode
    .replace(/\[([^\]]*?)>=\s*(?:stealth|latex|Stealth|Latex|triangle|open triangle)[^,\]]*,?\s*/gi, (m, before) => '[' + before)
    .replace(/,\s*>=\s*(?:stealth|latex|Stealth|Latex|triangle|open triangle)[^\],]*/gi, '')
    // Strip multi-token font options like font=\small\bfseries (causes \pgfmath@dimen@ error in TikZJax)
    .replace(/,?\s*font=\\[^,\]\s]+/g, '')
    .replace(/\[,\s*/g, '[')
    .replace(/,\s*\]/g, ']')
    .replace(/\[\s*\]/g, '')
    // Map CSS color names like 'indigo' to standard LaTeX xcolor 'blue!80!black'
    .replace(/\bindigo\b/gi, 'blue!80!black');

  // TikZJax's pgfsys-ximera SVG driver flips the entire coordinate system
  // but does NOT counter-flip \node text. Inject yscale=-1 to fix orientation.
  cleanCode = cleanCode.replace(
    /\\node(\[([^\]]*)\])?\s+at/g,
    (match, opts, inner) => {
      if (inner && (inner.includes('rotate') || inner.includes('yscale'))) return match;
      const newOpts = inner ? inner.trimEnd().replace(/,?$/, ',rotate=180') : 'rotate=180';
      return `\\node[${newOpts}] at`;
    }
  );

  const tikzMatch = cleanCode.match(/\\begin{(?:tikzpicture|pgfpicture)}[\s\S]*?\\end{(?:tikzpicture|pgfpicture)}/);
  if (tikzMatch) {
    cleanCode = tikzMatch[0];
  } else if (!cleanCode.startsWith('\\begin{tikzpicture}')) {
    cleanCode = `\\begin{tikzpicture}\n${cleanCode}\n\\end{tikzpicture}`;
  }

  const captionHtml = caption
    ? `<p class="text-xs text-neutral-500 italic mt-2.5 text-center max-w-lg font-mono">${caption}</p>`
    : '';

  return `<div class="tikz-diagram-wrapper my-6 flex flex-col items-center justify-center p-3 sm:p-5 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[6px_6px_0px_0px_#2a2a2a] max-w-full overflow-x-auto"><div class="tikz-canvas text-stone-900 max-w-full overflow-x-auto p-1 sm:p-2"><script type="text/tikz">\n${cleanCode}\n<\/script></div>${captionHtml}</div>`;
}



function renderSolutionSafe(raw: string): string {
  if (!raw?.trim()) return '';

  let text = raw;

  // Convert raw \( ... \) inline math into $ ... $ delimiters before markdown parser strips backslashes
  text = text.replace(/\\\(([\s\S]+?)\\\)/g, '$$$1$$');

  const tikzPlaceholders: string[] = [];

  // Extract ```tikz ... ``` fenced code blocks
  text = text.replace(/```tikz\s*(?:caption="([^"]*)")?\s*\n([\s\S]*?)```/gi, (_match, caption, code) => {
    const idx = tikzPlaceholders.length;
    tikzPlaceholders.push(buildTikzHtml(code, caption || ''));
    return `\n\nTIKZBLOCK_${idx}\n\n`;
  });

  // Extract Markdoc {% tikz ... %} tags
  text = text.replace(/{%\s*tikz\b[\s\S]*?(?:{%\s*\/tikz\s*%}|\/%|%})/gi, (match) => {
    let code = '';
    let caption = '';
    const codeMatch = match.match(/code="([\s\S]*?)"/);
    if (codeMatch) {
      code = codeMatch[1];
    } else {
      code = match.replace(/^{%\s*tikz[^%]*%}/i, '').replace(/{%\s*\/tikz\s*%}$/i, '');
    }
    const capMatch = match.match(/caption="([^"]*)"/);
    if (capMatch) caption = capMatch[1];

    const idx = tikzPlaceholders.length;
    tikzPlaceholders.push(buildTikzHtml(code, caption));
    return `\n\nTIKZBLOCK_${idx}\n\n`;
  });

  text = text.replace(/\\begin{(?:tikzpicture|pgfpicture)}[\s\S]*?\\end{(?:tikzpicture|pgfpicture)}/g, (match) => {
    const idx = tikzPlaceholders.length;
    tikzPlaceholders.push(buildTikzHtml(match));
    return `\n\nTIKZBLOCK_${idx}\n\n`;
  });

  const topSegments = text.split(/(\$\$[\s\S]*?\$\$)/g);
  let html = '';
  for (const seg of topSegments) {
    if (seg.startsWith('$$') && seg.endsWith('$$') && seg.length > 4) {
      // Strip Keystatic soft-break trailing slashes line-by-line while explicitly protecting \end{...}
      let cleanMath = seg
        .split('\n')
        .map(line => {
          const trimmed = line.trim();
          if (/^\\?end{/i.test(trimmed)) {
            return trimmed.startsWith('\\') ? trimmed : '\\' + trimmed;
          }
          return line.replace(/(?<!\\)\\\s*$/, '');
        })
        .join('\n');

      // 2. Neutralize Markdown bold & italic marks that Keystatic auto-injected inside $$ ... $$
      cleanMath = cleanMath.replace(/\*\*+/g, '');
      cleanMath = cleanMath.replace(/\\underbrace{([^}]+)}\*\{\\text{([^}]+)}\*/g, '\\underbrace{$1}_{\\text{$2}}');
      cleanMath = cleanMath.replace(/\\underbrace{([^}]+)}\*\{\\text{([^}]+)}/g, '\\underbrace{$1}_{\\text{$2}}');
      cleanMath = cleanMath.replace(/([a-zA-Z])\*\{([^}]+)\}\*/g, '$1_{$2}');
      cleanMath = cleanMath.replace(/([a-zA-Z])\*\{([^}]+)\}/g, '$1_{$2}');
      cleanMath = cleanMath.replace(/([a-zA-Z])\*([a-zA-Z0-9]+)/g, '$1_$2');
      cleanMath = cleanMath.replace(/\*([a-zA-Z0-9]+)\*/g, '$1');
      cleanMath = cleanMath.replaceAll('<', '&lt;').replaceAll('>', '&gt;');

      html += `<div class="solution-display-math">${cleanMath}</div>\n`;
    } else if (seg.trim()) {
      html += processTextSegment(seg);
    }
  }

  tikzPlaceholders.forEach((blockHtml, i) => {
    const token = `TIKZBLOCK_${i}`;
    html = html.replaceAll(`<p>${token}</p>`, blockHtml).replaceAll(token, blockHtml);
  });

  return html;
}

/** Render a table markdown / markdoc block into styled HTML */
function buildTableHtml(rawTable: string): string {
  let clean = rawTable
    .replace(/{%\s*table\s*%}/gi, '')
    .replace(/{%\s*\/table\s*%}/gi, '')
    .trim();

  let headerRow: string[] | null = null;
  const bodyRows: string[][] = [];

  // Check if it's a pipe table (| a | b |)
  const isPipeTable = clean.split('\n').some(l => l.trim().startsWith('|'));

  if (isPipeTable) {
    const lines = clean.split('\n').map(l => l.trim()).filter(l => l.length > 0 && l.startsWith('|'));
    for (const line of lines) {
      if (/^\|[\s\-:|]+\|$/.test(line)) {
        continue;
      }
      const content = line.startsWith('|') ? line.slice(1) : line;
      const trimmedEnd = content.endsWith('|') ? content.slice(0, -1) : content;
      const cells = trimmedEnd.split('|').map(c => c.trim());

      if (headerRow === null) {
        headerRow = cells;
      } else {
        bodyRows.push(cells);
      }
    }
  } else {
    // Markdoc list table syntax: rows separated by '---', cells start with '-' or '*'
    const rowBlocks = clean.split(/\n\s*---\s*\n|\n\s*\*\*\*\s*\n/);
    for (const block of rowBlocks) {
      const cells: string[] = [];
      const lines = block.split('\n');
      for (const rawLine of lines) {
        const line = rawLine.trim();
        if (/^[-*]\s+/.test(line)) {
          cells.push(line.replace(/^[-*]\s+/, '').trim());
        } else if (line !== '' && cells.length > 0) {
          cells[cells.length - 1] += ' ' + line;
        }
      }
      if (cells.length > 0) {
        if (headerRow === null) {
          headerRow = cells;
        } else {
          bodyRows.push(cells);
        }
      }
    }
  }

  if (!headerRow || headerRow.length === 0) return '';

  let tableHtml = '<div class="my-6 overflow-x-auto rounded-lg border border-neutral-200 bg-white shadow-xs">';
  tableHtml += '<table class="w-full text-left border-collapse text-xs sm:text-sm">';
  
  tableHtml += '<thead class="bg-neutral-50/90 border-b border-neutral-200">';
  tableHtml += '<tr>';
  for (const cell of headerRow) {
    tableHtml += `<th class="px-4 py-2.5 font-mono font-bold text-xs uppercase tracking-wider text-[#2a2a2a] border-r border-neutral-200 last:border-r-0">${applyInline(cell)}</th>`;
  }
  tableHtml += '</tr></thead>';

  tableHtml += '<tbody class="divide-y divide-neutral-200">';
  for (const row of bodyRows) {
    tableHtml += '<tr class="hover:bg-neutral-50/60 transition-colors">';
    for (let c = 0; c < headerRow.length; c++) {
      const cellContent = row[c] !== undefined ? row[c] : '';
      tableHtml += `<td class="px-4 py-2.5 text-[#2a2a2a] border-r border-neutral-100 last:border-r-0">${applyInline(cellContent)}</td>`;
    }
    tableHtml += '</tr>';
  }
  tableHtml += '</tbody></table></div>';

  return tableHtml;
}

function processTextSegment(text: string): string {
  if (!text) return '';
  // Pre-process multi-line Markdoc embed tags saved by Keystatic (e.g. {% wolfram\n #id ... /%}) into a single line tag
  let cleanText = text.replace(/{%\s*(youtube|wolfram|geogebra|audio)\b[\s\S]*?%}/gi, (match) => {
    return match.replace(/\s+/g, ' ').replace('/%}', '%}').replace(/%}/, ' %}{% /' + match.match(/youtube|wolfram|geogebra|audio/i)![0] + ' %}');
  });

  // Extract Markdoc {% table %} ... {% /table %} blocks
  const tablePlaceholders: string[] = [];
  cleanText = cleanText.replace(/{%\s*table\s*%}[\s\S]*?{%\s*\/table\s*%}/gi, (match) => {
    const idx = tablePlaceholders.length;
    tablePlaceholders.push(buildTableHtml(match));
    return `\n\nTABLEBLOCK_${idx}\n\n`;
  });

  const inlineMath: string[] = [];
  let s = cleanText.replace(/\$(?!\$)([^\$\n]+?)\$/g, (match) => {
    const token = `__IMATH_${inlineMath.length}__`;
    inlineMath.push(match);
    return token;
  });

  const rawLines = s.split('\n');
  const out: string[] = [];
  let inUl = false;

  for (let i = 0; i < rawLines.length; i++) {
    const raw = rawLines[i];
    let line = raw.trimEnd();
    let isHardBreak = false;
    if (/\\\s*$/.test(line)) {
      isHardBreak = true;
      line = line.replace(/\\\s*$/, '');
    }
    const trimmed = line.trimStart();

    if (/{%\s*(youtube|wolfram|geogebra|audio)\b[^%]*%}/i.test(trimmed)) {
      if (inUl) { out.push('</ul>'); inUl = false; }
      const match = trimmed.match(/{%\s*(youtube|wolfram|geogebra|audio)\s*([^%]*?)%}/i);
      if (match) {
        const tagType = match[1].toLowerCase();
        const rawAttrs = match[2] || '';
        const idMatch = rawAttrs.match(/id="([^"]+)"/) || rawAttrs.match(/#([^\s"]+)/);
        const queryMatch = rawAttrs.match(/query="([^"]+)"/);
        const urlMatch = rawAttrs.match(/url="([^"]+)"/);
        const titleMatch = rawAttrs.match(/title="([^"]+)"/);

        const id = idMatch ? idMatch[1] : '';
        const query = queryMatch ? queryMatch[1] : '';
        const url = urlMatch ? urlMatch[1] : '';
        const title = titleMatch ? titleMatch[1] : 'Interactive Content';

        let iframeHtml = buildEmbedHtml(tagType, id, query, url, title);
        out.push(iframeHtml);
        continue;
      }
    }

    const imgMatch = trimmed.match(/^!\[(.*?)\]\((.*?)\)$/);
    if (imgMatch) {
      if (inUl) { out.push('</ul>'); inUl = false; }
      const alt = imgMatch[1] || '';
      const url = imgMatch[2] || '';
      const captionHtml = alt
        ? `<figcaption class="text-xs font-mono text-neutral-500 italic mt-2.5 text-center">${alt}</figcaption>`
        : '';
      out.push(`<figure class="my-6 flex flex-col items-center justify-center p-3 sm:p-4 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[6px_6px_0px_0px_#2a2a2a] max-w-full overflow-hidden"><img src="${url}" alt="${alt}" class="max-w-full h-auto rounded-lg mx-auto block" loading="lazy" />${captionHtml}</figure>`);
      continue;
    }

    // Markdown Tables (lines starting with '|')
    if (trimmed.startsWith('|') && (trimmed.endsWith('|') || trimmed.includes('|'))) {
      if (inUl) { out.push('</ul>'); inUl = false; }
      const tableLines: string[] = [];
      while (i < rawLines.length) {
        const curTrimmed = rawLines[i].trim();
        if (curTrimmed.startsWith('|')) {
          tableLines.push(curTrimmed);
          i++;
        } else {
          break;
        }
      }
      i--; // rewind one because loop increments
      out.push(buildTableHtml(tableLines.join('\n')));
      continue;
    }

    if (/^###\s+/.test(trimmed)) {
      if (inUl) { out.push('</ul>'); inUl = false; }
      out.push(`<h3>${applyInline(trimmed.replace(/^###\s+/, ''))}</h3>`);
      continue;
    }
    if (/^##\s+/.test(trimmed)) {
      if (inUl) { out.push('</ul>'); inUl = false; }
      out.push(`<h2>${applyInline(trimmed.replace(/^##\s+/, ''))}</h2>`);
      continue;
    }
    if (/^#\s+/.test(trimmed)) {
      if (inUl) { out.push('</ul>'); inUl = false; }
      out.push(`<h1>${applyInline(trimmed.replace(/^#\s+/, ''))}</h1>`);
      continue;
    }
    if (/^[-*]\s+/.test(trimmed)) {
      if (!inUl) { out.push('<ul>'); inUl = true; }
      out.push(`<li>${applyInline(trimmed.replace(/^[-*]\s+/, ''))}</li>`);
      continue;
    }
    if (inUl) { out.push('</ul>'); inUl = false; }
    if (trimmed === '') { out.push(''); continue; }
    
    const inlineContent = applyInline(trimmed);
    out.push(isHardBreak ? `${inlineContent}<br />` : inlineContent);
  }
  if (inUl) out.push('</ul>');

  let html = '';
  let para: string[] = [];
  const isBlock = /^<(h[1-6]|ul|ol|li|div|figure|blockquote|pre|hr|table)/i;

  for (const line of out) {
    if (line === '') {
      if (para.length) { html += `<p>${para.join(' ')}</p>\n`; para = []; }
    } else if (isBlock.test(line)) {
      if (para.length) { html += `<p>${para.join(' ')}</p>\n`; para = []; }
      html += line + '\n';
    } else {
      para.push(line);
    }
  }
  if (para.length) html += `<p>${para.join(' ')}</p>\n`;

  // Restore table placeholders
  tablePlaceholders.forEach((tblHtml, i) => {
    const token = `TABLEBLOCK_${i}`;
    html = html.replaceAll(`<p>${token}</p>`, tblHtml).replaceAll(token, tblHtml);
  });

  inlineMath.forEach((m, i) => {
    const safeM = m.replaceAll('<', '&lt;').replaceAll('>', '&gt;');
    html = html.replaceAll(`__IMATH_${i}__`, safeM);
  });
  return html;
}

function applyInline(text: string): string {
  return text
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_m, alt, url) => {
      const captionHtml = alt
        ? `<figcaption class="text-xs font-mono text-neutral-500 italic mt-2.5 text-center">${alt}</figcaption>`
        : '';
      return `<figure class="my-6 flex flex-col items-center justify-center p-3 sm:p-4 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[6px_6px_0px_0px_#2a2a2a] max-w-full overflow-hidden"><img src="${url}" alt="${alt}" class="max-w-full h-auto rounded-lg mx-auto block" loading="lazy" />${captionHtml}</figure>`;
    })
    .replace(/\[([^\]]+)\]\((https?:\/\/(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([^)&]+))\)/g, (_match, title, _url, ytId) => {
      return `<div class="my-6 bg-white border-[3px] border-[#2a2a2a] rounded-xl p-3 shadow-[6px_6px_0px_0px_#2a2a2a]"><div class="flex items-center justify-between pb-2 mb-2 border-b-2 border-dashed border-neutral-200 font-mono text-xs font-bold text-[#2a2a2a]"><span class="px-2 py-0.5 bg-red-100 border border-red-300 text-red-700 rounded text-[10px] font-black uppercase">Video: ${title}</span></div><div class="relative w-full overflow-hidden rounded-lg border-2 border-[#2a2a2a] bg-black" style="padding-top:56.25%"><iframe src="https://www.youtube-nocookie.com/embed/${ytId}" title="${title}" class="absolute top-0 left-0 w-full h-full" allowfullscreen loading="lazy"></iframe></div></div>`;
    })
    .replace(/<sup>\s*\[\[([^\]]+)\]\]\((#[^)]+)\)\s*<\/sup>/g, '<sup class="ml-0.5 font-bold"><a href="$2" class="text-indigo-600 hover:underline cursor-pointer">[$1]</a></sup>')
    .replace(/\[([^\]]+)\]\((#[^)]+)\)/g, '<a href="$2" class="font-bold text-indigo-600 hover:underline cursor-pointer">$1</a>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="font-bold text-indigo-600 underline decoration-2 hover:bg-indigo-50 px-1 rounded transition-colors">$1</a>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*\n]+?)\*/g, '<em>$1</em>')
    .replace(/`([^`\n]+?)`/g, '<code class="px-1 py-0.5 bg-neutral-100 border rounded font-mono text-xs">$1</code>');
}


const rawArticleFiles = import.meta.glob('/src/content/articles/*.{md,mdoc}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const articleKey = `/src/content/articles/${article.id}`;
const altArticleKey = `/src/content/articles/${article.id.replace(/\.(md|mdoc)$/, '')}.md`;
const articleFileContent = rawArticleFiles[articleKey] || rawArticleFiles[altArticleKey] || '';

let rawArticleBody = article.body || '';
if (articleFileContent && !rawArticleBody) {
  const frontmatterMatch = articleFileContent.match(/^---[\s\S]*?---\n([\s\S]*)$/);
  if (frontmatterMatch) {
    rawArticleBody = frontmatterMatch[1].trim();
  }
}

const articleHtml = renderSolutionSafe(rawArticleBody || article.body || '');

const pageTitle = `${article.data.title} - Mathematical Articles & Essays // deMath`;
const pageDescription = `Read "${article.data.title}", published on ${article.data.publishDate.toLocaleDateString('en-US')}. Tags: ${article.data.tags.join(', ')}`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  ogType="article"
>


  <SEOJsonLd
    type="article"
    title={article.data.title}
    description={pageDescription}
    url={Astro.url.href}
    tags={article.data.tags}
    datePublished={article.data.publishDate.toISOString()}
  />

  <div class="min-h-screen bg-[#f5f5f2] relative overflow-hidden font-sans py-6 sm:py-12">

    <!-- Blueprint Paper Grid Lines -->
    <div class="absolute inset-0 z-0 opacity-[0.04] pointer-events-none"
         style="background-size: 24px 24px; background-image: linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px);">
    </div>

    <div class="max-w-4xl px-2 sm:px-6 mx-auto relative z-10 space-y-6">

      <!-- Back Navigation Link -->
      <div class="mb-4 px-1 sm:px-0">
        <a
          href="/articles"
          class="inline-flex items-center gap-1 font-mono text-xs font-bold text-indigo-600 hover:underline"
        >
          ← Back to Publications
        </a>
      </div>

      <!-- Main Master Textbook Canvas Card -->
      <article class="bg-white border-[3px] border-[#2a2a2a] rounded-2xl p-3.5 sm:p-10 shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[8px_8px_0px_0px_#2a2a2a] relative">

        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b-2 border-dashed border-neutral-200 mb-6">
          <span class="text-xs font-mono font-bold text-neutral-500">
            By: {article.data.author || 'Saad Hassan'}
          </span>
          <span class="text-[10px] font-mono font-bold text-neutral-400">
            Published: {article.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        </div>

        <!-- High Contrast Headline -->
        <h1 class="text-[28px] md:text-[40px] lg:text-[48px] font-black text-[#2a2a2a] tracking-tight leading-tight mb-6">
          {article.data.title}
        </h1>

        <!-- Inline Tags Cloud -->
        {article.data.tags && article.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {article.data.tags.map(tag => (
              <a
                href={`/articles?tag=${tag}`}
                class="px-2 py-0.5 border-2 border-[#2a2a2a] bg-neutral-50 rounded font-mono text-xs font-bold text-neutral-600 hover:bg-[#ebef70] transition-colors shadow-[1px_1px_0px_#2a2a2a]"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- The Rendered Markdown Content Canvas -->
        <div class="prose-textbook text-[#2a2a2a]">
          <div set:html={articleHtml} />
        </div>


        <!-- ── BIBLIOGRAPHY & REFERENCES ───────────────────────────── -->
        {article.data.references && article.data.references.length > 0 && (
          <div class="mt-10 pt-6 border-t-2 border-dashed border-neutral-200">
            <h3 class="font-mono text-xs font-black uppercase tracking-widest text-neutral-500 mb-4 flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              Bibliography & References
            </h3>
            <ol class="space-y-2.5 font-mono text-xs text-[#2a2a2a]">
              {article.data.references.map((ref, idx) => (
                <li id={`ref-${idx + 1}`} class="flex items-start gap-2 p-2.5 rounded-lg bg-neutral-50 border border-neutral-200 hover:border-[#2a2a2a] transition-all">
                  <span class="font-bold text-indigo-600 select-none">[{idx + 1}]</span>
                  <div class="flex-1">
                    <span class="font-bold">{ref.title}</span>
                    {ref.details && <span class="text-neutral-500 ml-1.5">— {ref.details}</span>}
                  </div>
                  {ref.url && (
                    <a
                      href={ref.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-bold text-indigo-600 hover:underline shrink-0 ml-2"
                    >
                      Link <span class="text-[10px]">↗</span>
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        )}

      </article>

      <!-- Workspace Footer Note -->
      <div class="text-center font-mono text-[11px] font-bold text-neutral-400 pt-4">
        // End of publication block. All rights reserved.
      </div>

    </div>
  </div>
</Layout>

<style is:global>
