    font-size: 0.9375rem;
    line-height: 1.7;
    color: #2e2e2e;
    margin-bottom: 0.35rem;
  }

  @media (min-width: 640px) {
    .prose-textbook li {
      font-size: 1.03125rem;
      line-height: 1.75;
    }
  }

  .prose-textbook strong {
    color: #111111;
    font-weight: 750;
  }

  .prose-textbook em {
    color: #333333;
    font-style: italic;
  }

  /* Math Blocks formatting fixes */
  .prose-textbook .katex-display {
    padding: 0.75rem 0.875rem;
    background-color: #ffffff;
    border: 2px solid #2a2a2a;
    border-radius: 0.75rem;
    box-shadow: 2.5px 2.5px 0px 0px #2a2a2a;
    margin: 1rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    max-width: 100%;
  }

  .prose-textbook .katex {
    color: #1a1a1a !important;
    font-size: 0.9em;
  }

  @media (min-width: 640px) {
    .prose-textbook .katex-display {
      padding: 1.25rem;
      margin: 1.5rem 0;
      box-shadow: 4px 4px 0px 0px #2a2a2a;
    }
    .prose-textbook .katex {
      font-size: 1.05em;
    }
  }

  /* Table formatting fixes for Markdoc / Markdown tables */
  .prose-textbook table {
    width: 100%;
