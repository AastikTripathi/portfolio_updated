---
// src/pages/problems/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

const allProblems = await getCollection('problems');
const allCategories = await getCollection('categories');

// 1. Dynamic tag compilation for the UI sidebar cloud
const uniqueTagsMap = new Map<string, number>();
const uniqueYearsSet = new Set<number>();

allProblems.forEach(p => {
  if (p.data.tags) {
    p.data.tags.forEach(t => {
      uniqueTagsMap.set(t, (uniqueTagsMap.get(t) || 0) + 1);
    });
  }
  if (p.data.year) {
    uniqueYearsSet.add(p.data.year);
  }
});

const sortedYears = Array.from(uniqueYearsSet).sort((a, b) => b - a);

const examLabels: Record<string, string> = {
  JEE: 'JEE (Main / Advanced)',
  ISI: 'ISI (Indian Statistical Institute)',
  CMI: 'CMI (Chennai Math Institute)',
  PUTNAM: 'Putnam Competition',
  AIME: 'AIME (American Invitational)',
  IOQM: 'IOQM (Indian Qualifier)',
  HMMT: 'HMMT (Harvard-MIT)',
  RMO: 'RMO (Regional Olympiad)',
  INMO: 'INMO (Indian National)',
  IMO: 'IMO (International)',
  TST: 'TST (Team Selection)',
  RMM: 'RMM (Romanian Master)',
  BMO: 'BMO (British Olympiad)',
  Olympiad: 'Olympiad General'
};

// 2. Serialize ONLY the necessary searchable metadata to keep payload tiny
const serializedProblems = allProblems.map(p => {
  const rawCat = p.data.category;
  const cleanCat = typeof rawCat === 'object' && rawCat !== null
    ? rawCat.id.replace(/\.(yaml|yml)$/, '')
    : String(rawCat || '').replace(/\.(yaml|yml)$/, '');

  return {
    id: p.id,
    title: p.data.title,
    difficulty: p.data.difficulty || 'Intermediate',
    superCategory: p.data.superCategory || 'Olympiad',
    year: p.data.year || null,
    tags: p.data.tags || [],
    category: cleanCat,
    dateStr: p.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  };
});
---

<Layout 
  title="Problem Archive | IMO, Putnam, AIME, ISI, CMI, JEE, HMMT, RMO, INMO, BMO Proofs"
  description="Explore competition mathematics problems, proofs, and solutions from IMO, Putnam, AIME, ISI, CMI, JEE, IOQM, HMMT, RMO, INMO, TST, RMM, and BMO."
>
  <SEOJsonLd
    type="collection"
    title="Mathematics Problem Archive"
    description="Searchable archive of IMO, Putnam, AIME, ISI, CMI, JEE, IOQM, HMMT, RMO, INMO, TST, RMM, and BMO contest problems and proofs."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#f5f5f2] relative overflow-hidden font-sans pt-12">
    <div class="absolute inset-0 z-0 opacity-[0.04] pointer-events-none"
         style="background-size: 24px 24px; background-image: linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px);">
    </div>

    <main class="max-w-7xl px-4 mx-auto sm:px-6 relative z-10 grid grid-cols-1 lg:grid-cols-4 gap-8 pb-24">

      <!-- LEFT COLUMN: Advanced Filtering Matrix Sidebar -->
      <div class="lg:col-span-1 space-y-6">

        <!-- Text Search and Advanced Controls Box -->
        <div class="p-4 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] space-y-4">
          <div>
            <span class="block text-[11px] font-mono font-black tracking-widest text-neutral-400 mb-1 uppercase">Text Search</span>
            <input
              type="text"
              id="search-input"
              placeholder="Search title, year, tags..."
              class="w-full px-3 py-1.5 border-2 border-[#2a2a2a] rounded-lg text-xs font-mono focus:outline-none focus:bg-[#ebef70]/10"
            />
          </div>

          <!-- Advanced Dropdown 1: Target Exam / Competition -->
          <div>
            <span class="block text-[11px] font-mono font-black tracking-widest text-neutral-400 mb-1 uppercase">Target Competition</span>
            <select id="exam-filter" class="w-full px-2 py-1.5 border-2 border-[#2a2a2a] rounded-lg text-xs font-mono bg-white text-[#2a2a2a] focus:outline-none transition-colors">
              <option value="">All Competitions (13 Exams)</option>
              {Object.entries(examLabels).map(([val, label]) => (
                <option value={val} class="bg-white text-[#2a2a2a]">{label}</option>
              ))}
            </select>
          </div>

          <!-- Advanced Dropdown 2: Competition Year -->
          <div>
            <span class="block text-[11px] font-mono font-black tracking-widest text-neutral-400 mb-1 uppercase">Competition Year</span>
            <select id="year-filter" class="w-full px-2 py-1.5 border-2 border-[#2a2a2a] rounded-lg text-xs font-mono bg-white text-[#2a2a2a] focus:outline-none transition-colors">
              <option value="">All Years</option>
              {sortedYears.map((yr) => (
                <option value={yr} class="bg-white text-[#2a2a2a]">{yr}</option>
              ))}
            </select>
          </div>

          <!-- Advanced Dropdown 3: Difficulty Level -->
          <div>
            <span class="block text-[11px] font-mono font-black tracking-widest text-neutral-400 mb-1 uppercase">Difficulty</span>
            <select id="difficulty-filter" class="w-full px-2 py-1.5 border-2 border-[#2a2a2a] rounded-lg text-xs font-mono bg-white text-[#2a2a2a] focus:outline-none transition-colors">
              <option value="">All Difficulties</option>
              <option value="Beginner" class="bg-white text-[#2a2a2a]">Beginner</option>
              <option value="Intermediate" class="bg-white text-[#2a2a2a]">Intermediate</option>
              <option value="Advanced" class="bg-white text-[#2a2a2a]">Advanced</option>
              <option value="Elite" class="bg-white text-[#2a2a2a]">Elite / Olympiad</option>
            </select>
          </div>

          <button id="reset-filters" class="w-full py-1.5 bg-neutral-100 hover:bg-neutral-200 border-2 border-[#2a2a2a] text-[#2a2a2a] font-mono text-xs font-bold rounded transition-colors uppercase tracking-wider">
            Clear
          </button>
        </div>

        <!-- Topics Static Routes Submenu -->
        <div class="p-5 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] space-y-3">
          <h4 class="font-sketch text-lg font-bold border-b-2 border-[#2a2a2a] pb-1">Topics</h4>
          <div class="flex flex-col gap-2">
            {allCategories.map((cat) => (
              <a href={`/category/${cat.id.replace(/\.(yaml|yml)$/, '')}`} class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold border-2 bg-neutral-50 border-neutral-200 text-[#2a2a2a] hover:border-[#2a2a2a] hover:bg-[#ebef70]/10 block">
                {cat.data.name} →
              </a>
            ))}
          </div>
        </div>

        <!-- Conceptual Tag Cloud -->
        <div class="p-5 bg-white border-[3px] border-[#2a2a2a] rounded-xl shadow-[4px_4px_0px_0px_#2a2a2a] space-y-3">
          <div class="flex items-center justify-between border-b-2 border-[#2a2a2a] pb-1">
            <h4 class="font-sketch text-lg font-bold">Tags</h4>
            <button id="clear-tags-btn" class="hidden text-[10px] font-mono font-bold text-indigo-600 hover:underline uppercase">
              Clear Tags
            </button>
          </div>

          <!-- Active Selected Tags Bar (Appears at top when tags are active) -->
          <div id="active-tags-container" class="hidden flex flex-wrap gap-1.5 p-2 bg-[#ebef70]/20 border-2 border-dashed border-[#2a2a2a] rounded-lg"></div>

          <!-- Main Tag Cloud -->
          <div class="flex flex-wrap gap-1.5">
            {Array.from(uniqueTagsMap.entries()).map(([tag, count]) => (
              <button data-tag-btn={tag} class="tag-btn px-2 py-0.5 rounded text-[11px] font-mono font-bold border bg-neutral-50 border-neutral-200 hover:border-[#2a2a2a] transition-all">
                #{tag} ({count})
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Infinite-Scale Pagination Stream Canvas -->
      <div class="lg:col-span-3 space-y-6">
        <div class="border-b-[3px] border-[#2a2a2a] pb-4 space-y-3">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2">
            <div>
              <h1 id="vault-title" class="font-sketch hero-heading font-semibold text-[#2a2a2a]">Problem Archive</h1>
              <p id="vault-counter" class="text-xs font-mono font-bold text-neutral-500 mt-1">Loading problems...</p>
            </div>
            <div class="px-2.5 py-1 bg-[#ebef70] border-2 border-[#2a2a2a] rounded-lg font-mono text-[10px] font-bold shadow-[2px_2px_0px_#2a2a2a]">
              Zero Rote • Pure Rigor
            </div>
          </div>

          <!-- Saad Hassan Philosophy Callout Banner -->
          <div class="p-3.5 bg-white border-2 border-[#2a2a2a] rounded-xl shadow-[3px_3px_0px_#2a2a2a] space-y-1">
            <p class="text-xs text-neutral-700 italic font-medium leading-relaxed">
              "Any problem worthy of an attack proves its worth by fighting back. Mathematics is built on the back of first principles, and it begins where the toolkit ends."
            </p>
            <span class="block font-mono text-[10px] font-bold text-neutral-500 text-right">Saad Hassan</span>
          </div>

        </div>


        <!-- The Target Container DOM Node: Script injects max 20 cards here -->
        <div id="problems-mount" class="space-y-6"></div>

        <!-- Pagination Controls Navigation Component -->
        <div class="flex items-center justify-center gap-2 pt-6 border-t-[3px] border-[#2a2a2a] font-mono text-xs select-none">
          <button id="prev-page" class="w-8 h-8 flex items-center justify-center bg-white border-2 border-[#2a2a2a] rounded-lg shadow-[2px_2px_0px_#2a2a2a] disabled:opacity-40 disabled:pointer-events-none font-bold active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all">
            ←
          </button>
          <div id="page-numbers" class="flex items-center gap-1.5"></div>
          <button id="next-page" class="w-8 h-8 flex items-center justify-center bg-white border-2 border-[#2a2a2a] rounded-lg shadow-[2px_2px_0px_#2a2a2a] disabled:opacity-40 disabled:pointer-events-none font-bold active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all">
            →
          </button>
        </div>
      </div>
    </main>
  </div>
</Layout>

<!-- ⚡ HIGH-PERFORMANCE STATIC FEED CONTROLLER ENGINE ⚡ -->
<script define:vars={{ serializedProblems }}>
  function initProblems() {
    const mountNode = document.getElementById('problems-mount');
    if (!mountNode) return;

    let currentPage = 1;
    const ITEMS_PER_PAGE = 8;
    const selectedTags = new Set();
    const validExams = ['JEE', 'ISI', 'CMI', 'PUTNAM', 'AIME', 'IOQM', 'HMMT', 'RMO', 'INMO', 'IMO', 'TST', 'RMM', 'BMO'];

    // Sync initialization state directly from URL patterns if bookmarked
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tag')) selectedTags.add(urlParams.get('tag'));

    const searchParam = urlParams.get('search');
    const examFilterEl = document.getElementById('exam-filter');
    const searchInputEl = document.getElementById('search-input');
    const yearFilterEl = document.getElementById('year-filter');
    const difficultyFilterEl = document.getElementById('difficulty-filter');

    if (searchParam) {
      const upperSearch = searchParam.toUpperCase();
      if (validExams.includes(upperSearch)) {
        if (examFilterEl) examFilterEl.value = upperSearch;
      } else {
        if (searchInputEl) searchInputEl.value = searchParam;
      }
    }

    if (urlParams.get('exam') && examFilterEl) examFilterEl.value = urlParams.get('exam').toUpperCase();
    if (urlParams.get('year') && yearFilterEl) yearFilterEl.value = urlParams.get('year');
    if (urlParams.get('difficulty') && difficultyFilterEl) difficultyFilterEl.value = urlParams.get('difficulty');

    function renderPipeline() {
      const searchVal = searchInputEl ? searchInputEl.value.toLowerCase().trim() : '';
      const difficultyVal = difficultyFilterEl ? difficultyFilterEl.value : '';
      const examVal = examFilterEl ? examFilterEl.value : '';
      const yearVal = yearFilterEl ? yearFilterEl.value : '';

      // Step 1: Filter the lightweight JSON array with Multi-Tag OR logic
      const filtered = serializedProblems.filter(p => {
        if (selectedTags.size > 0) {
          const hasMatch = p.tags.some(t => selectedTags.has(t));
          if (!hasMatch) return false;
        }

        if (difficultyVal && p.difficulty !== difficultyVal) return false;
        if (examVal && p.superCategory !== examVal) return false;
        if (yearVal && String(p.year) !== String(yearVal)) return false;

        if (searchVal) {
          const titleMatch = p.title.toLowerCase().includes(searchVal);
          const superMatch = p.superCategory.toLowerCase().includes(searchVal);
          const yearMatch = p.year ? String(p.year).includes(searchVal) : false;
          const tagMatch = p.tags.some(t => t.toLowerCase().includes(searchVal));
          return titleMatch || superMatch || yearMatch || tagMatch;
        }
        return true;
      });

      // Step 2: Compute Pagination Parameters
      const totalPages = Math.ceil(filtered.length / ITEMS_PER_PAGE) || 1;
      if (currentPage > totalPages) currentPage = totalPages;

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      const pageItems = filtered.slice(startIndex, endIndex);

      // Step 3: Inject ONLY the active page chunk items into the DOM
      const targetMount = document.getElementById('problems-mount');
      if (!targetMount) return;

      if (pageItems.length === 0) {
        targetMount.innerHTML = `
          <div class="p-12 border-[3px] border-dashed border-neutral-300 rounded-2xl text-center font-mono text-xs text-neutral-400 bg-white">
            No records found matching current query parameters. Try widening filters.
          </div>`;
      } else {
        targetMount.innerHTML = pageItems.map(p => `
          <div class="group block p-6 bg-white border-[3px] border-[#2a2a2a] rounded-2xl shadow-[6px_6px_0px_0px_#2a2a2a] hover:shadow-[8px_8px_0px_0px_#2a2a2a] hover:-translate-x-[2px] hover:-translate-y-[2px] transition-all duration-200 relative overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 border-2 border-[#2a2a2a] bg-[#ebef70] text-[10px] font-mono font-black rounded shadow-[1px_1px_0px_#2a2a2a]">${p.superCategory}</span>
                ${p.year ? `<span class="px-2 py-0.5 border-2 border-[#2a2a2a] bg-indigo-100 text-[10px] font-mono font-black rounded shadow-[1px_1px_0px_#2a2a2a]">${p.year}</span>` : ''}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-black uppercase bg-[#2a2a2a] text-white tracking-wider">${p.difficulty}</span>
              </div>
              <span class="text-xs text-neutral-400 font-mono">${p.dateStr}</span>
            </div>
            <h3 class="text-2xl font-black text-[#2a2a2a] group-hover:text-indigo-600 transition-colors mb-2">${p.title}</h3>
            ${p.tags.length ? `
              <div class="flex flex-wrap gap-1.5 mb-4">
                ${p.tags.map(t => `<span class="text-[10px] font-mono text-neutral-500 bg-neutral-100 border border-neutral-200 px-1.5 py-0.5 rounded">#${t}</span>`).join('')}
              </div>` : ''}
            <div class="flex justify-between items-center pt-2 border-t border-dashed border-neutral-200">
              <a href="/problems/${p.id}" class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-wider text-indigo-600 underline decoration-2">
                View Proof & Solution →
              </a>
            </div>
          </div>
        `).join('');
      }

      // Helper to style active dropdowns
      function updateSelectStyle(el) {
        if (!el) return;
        if (el.value) {
          el.classList.add('bg-[#2a2a2a]', 'text-white', 'font-bold');
          el.classList.remove('bg-white', 'text-[#2a2a2a]');
        } else {
          el.classList.remove('bg-[#2a2a2a]', 'text-white', 'font-bold');
          el.classList.add('bg-white', 'text-[#2a2a2a]');
        }
      }

      updateSelectStyle(examFilterEl);
      updateSelectStyle(yearFilterEl);
      updateSelectStyle(difficultyFilterEl);

      // Render Active Tags Bar
      const activeTagsContainer = document.getElementById('active-tags-container');
      const clearTagsBtn = document.getElementById('clear-tags-btn');

      if (activeTagsContainer && clearTagsBtn) {
        if (selectedTags.size > 0) {
          activeTagsContainer.classList.remove('hidden');
          clearTagsBtn.classList.remove('hidden');
          activeTagsContainer.innerHTML = Array.from(selectedTags).map(t => `
            <button data-remove-tag="${t}" class="px-2 py-0.5 rounded text-[11px] font-mono font-bold border-2 border-[#2a2a2a] bg-[#ebef70] text-[#2a2a2a] shadow-[2px_2px_0px_#2a2a2a] flex items-center gap-1 hover:bg-red-200 transition-colors">
              #${t} <span class="font-black text-xs">✕</span>
            </button>
          `).join('');

          activeTagsContainer.querySelectorAll('[data-remove-tag]').forEach(b => {
            b.addEventListener('click', (e) => {
              e.stopPropagation();
              const t = b.getAttribute('data-remove-tag');
              selectedTags.delete(t);
              currentPage = 1;
              renderPipeline();
            });
          });
        } else {
          activeTagsContainer.classList.add('hidden');
          clearTagsBtn.classList.add('hidden');
          activeTagsContainer.innerHTML = '';
        }
      }

      // Counter
      const counterEl = document.getElementById('vault-counter');
      if (counterEl) counterEl.textContent = `Showing ${filtered.length} problem${filtered.length === 1 ? '' : 's'}.`;
      
      // Render page numbers dynamically
      const pageNumbersContainer = document.getElementById('page-numbers');
      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const isCurrent = i === currentPage;
          const activeClass = isCurrent 
            ? 'bg-[#2a2a2a] text-white' 
            : 'bg-white text-[#2a2a2a] shadow-[2px_2px_0px_#2a2a2a] hover:bg-neutral-100 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none';
          
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 flex items-center justify-center border-2 border-[#2a2a2a] rounded-lg font-bold transition-all ${activeClass}`;
          btn.textContent = i;
          btn.addEventListener('click', () => {
            currentPage = i;
            renderPipeline();
            window.scrollTo({top: 0, behavior: 'smooth'});
          });
          pageNumbersContainer.appendChild(btn);
        }
      }
      
      const prevBtn = document.getElementById('prev-page');
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      const nextBtn = document.getElementById('next-page');
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      // Update dynamic UI status for tag cloud buttons
      document.querySelectorAll('.tag-btn').forEach(btn => {
        const tagVal = btn.getAttribute('data-tag-btn');
        if (selectedTags.has(tagVal)) {
          btn.classList.add('bg-[#2a2a2a]', 'text-white', 'border-[#2a2a2a]');
          btn.classList.remove('bg-neutral-50', 'text-[#2a2a2a]');
        } else {
          btn.classList.remove('bg-[#2a2a2a]', 'text-white', 'border-[#2a2a2a]');
          btn.classList.add('bg-neutral-50', 'text-[#2a2a2a]');
        }
      });
    }

    // Hook Up Action Listeners
    if (searchInputEl) searchInputEl.addEventListener('input', () => { currentPage = 1; renderPipeline(); });
    if (difficultyFilterEl) difficultyFilterEl.addEventListener('change', () => { currentPage = 1; renderPipeline(); });
    if (examFilterEl) examFilterEl.addEventListener('change', () => { currentPage = 1; renderPipeline(); });
    if (yearFilterEl) yearFilterEl.addEventListener('change', () => { currentPage = 1; renderPipeline(); });

    document.querySelectorAll('.tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag-btn');
        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
        } else {
          selectedTags.add(tag);
        }
        currentPage = 1;
        renderPipeline();
      });
    });

    const clearTagsBtn = document.getElementById('clear-tags-btn');
    if (clearTagsBtn) {
      clearTagsBtn.addEventListener('click', () => {
        selectedTags.clear();
        currentPage = 1;
        renderPipeline();
      });
    }

    const resetFiltersBtn = document.getElementById('reset-filters');
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        if (searchInputEl) searchInputEl.value = '';
        if (difficultyFilterEl) difficultyFilterEl.value = '';
        if (examFilterEl) examFilterEl.value = '';
        if (yearFilterEl) yearFilterEl.value = '';
        selectedTags.clear();
        currentPage = 1;
        renderPipeline();
      });
    }

    const prevPageBtn = document.getElementById('prev-page');
    if (prevPageBtn) {
      prevPageBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderPipeline();
          window.scrollTo({top: 0, behavior: 'smooth'});
        }
      });
    }

    const nextPageBtn = document.getElementById('next-page');
    if (nextPageBtn) {
      nextPageBtn.addEventListener('click', () => {
        currentPage++;
        renderPipeline();
        window.scrollTo({top: 0, behavior: 'smooth'});
      });
    }

    // Boot Engine
    renderPipeline();
  }

  // Run on initial evaluation and after view transitions
  initProblems();
  document.addEventListener('astro:page-load', initProblems);
</script>