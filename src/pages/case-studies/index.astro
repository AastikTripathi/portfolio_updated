---
// src/pages/case-studies/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

const caseStudies = await getCollection('caseStudies');
---

<Layout 
  title="Case Studies | Aastik Tripathi"
  description="Detailed architectural and engineering case studies by Aastik Tripathi."
>
  <SEOJsonLd
    type="website"
    title="Case Studies - Aastik Tripathi"
    description="In-depth breakdowns of architecture, systems, and performance engineering."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#0d0f14] text-[#e6e8ec] py-12 sm:py-16">
    <div class="max-w-7xl px-4 mx-auto sm:px-6 space-y-12">

      <!-- Header Banner Frame with Solid Block Shadow -->
      <div class="border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] p-6 sm:p-12 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842]">
        <div class="inline-block px-3 py-1 border-2 border-[#000000] bg-[#e5b842] text-[#0d0f14] font-mono text-[10px] font-bold rounded-full shadow-[3px_3px_0px_#ffffff] mb-4">
          DEEP DIVES
        </div>
        <h1 class="hero-heading text-[#e6e8ec] mb-3">
          Engineering <span class="text-[#e5b842] underline decoration-[3px] decoration-[#e5b842]">Case Studies</span>
        </h1>
        <p class="text-xs sm:text-sm font-mono text-neutral-400 max-w-2xl leading-relaxed">
          First-principles technical breakdowns covering problem context, system design tradeoffs, implementation hurdles, and measured outcomes.
        </p>
      </div>

      <!-- Case Studies List with Solid Block Shadows -->
      <div class="space-y-8">
        {caseStudies.map((study, idx) => (
          <div class="p-6 sm:p-10 bg-[#1a1e28] border-2 border-[#2e3545] rounded-2xl sm:rounded-3xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all">
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
              
              <div class="space-y-4 max-w-3xl">
                <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-neutral-400">
                  <span class="px-2.5 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-[#e5b842] rounded font-bold shadow-[1px_1px_0px_#e5b842]">
                    {study.data.clientOrProject}
                  </span>
                  <span>•</span>
                  <span>Timeline: {study.data.timeline}</span>
                  <span>•</span>
                  <span>Role: {study.data.role}</span>
                </div>

                <h2 class="card-heading text-xl sm:text-2xl text-[#e6e8ec] hover:text-[#e5b842] transition-colors">
                  <a href={`/case-studies/${study.id}`}>
                    {study.data.title}
                  </a>
                </h2>

                {study.data.subtitle && (
                  <p class="text-xs sm:text-sm font-mono text-[#e5b842]">
                    {study.data.subtitle}
                  </p>
                )}

                <p class="text-xs sm:text-sm font-mono text-neutral-300 leading-relaxed">
                  {study.data.summary}
                </p>

                <!-- Impact Highlights -->
                {study.data.impactHighlights && study.data.impactHighlights.length > 0 && (
                  <div class="pt-2">
                    <span class="font-mono text-[11px] text-neutral-400 block mb-1 uppercase tracking-wider">// Measurable Results</span>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-mono text-xs text-neutral-200">
                      {study.data.impactHighlights.map((highlight) => (
                        <li class="flex items-start gap-2 bg-[#14171f] border border-[#2e3545] p-2 rounded-lg shadow-[2px_2px_0px_#0d0f14]">
                          <span class="text-[#e5b842]">✔</span>
                          <span>{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <!-- Tech Stack Chips -->
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {study.data.techStack.map((tech) => (
                    <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-neutral-400 rounded text-[10px] font-mono">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- CTA Button with 3D Tactile Push -->
              <div class="shrink-0 pt-4 lg:pt-0">
                <a
                  href={`/case-studies/${study.id}`}
                  class="inline-flex items-center gap-2 px-5 py-2.5 font-mono font-bold text-xs uppercase border-2 border-[#000000] rounded-xl bg-[#e5b842] text-[#0d0f14] shadow-[4px_4px_0px_#ffffff] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#ffffff] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
                >
                  READ STUDY →
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>
