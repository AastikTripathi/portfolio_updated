---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SEOJsonLd from '../components/SEOJsonLd.astro';

// Fetch collections created via Keystatic / content folders
const projects = await getCollection('projects');
const caseStudies = await getCollection('caseStudies');
const blogs = await getCollection('blogs');
const careerMilestones = await getCollection('career');

const featuredProjects = projects.sort((a, b) => a.data.order - b.data.order);
const featuredCaseStudies = caseStudies.slice(0, 2);
const recentBlogs = blogs.slice(0, 3);
const latestCareer = careerMilestones.sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<Layout 
  title="Aastik Tripathi | Portfolio, Projects & Systems Engineering"
  description="Personal portfolio, architectural case studies, project archives, and career timeline of Aastik Tripathi."
>
  <SEOJsonLd
    type="website"
    title="Aastik Tripathi - Portfolio & Engineering Archive"
    description="Explore projects, case studies, technical writings, and career milestones of Aastik Tripathi."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#0d0f14] text-[#e6e8ec] relative overflow-hidden font-sans py-12 sm:py-16">
    <div class="max-w-7xl px-4 mx-auto sm:px-6 relative z-10 space-y-16 sm:space-y-20">

      <!-- ================= HERO SECTION ================= -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- LEFT COLUMN: Intro Copywriting & Action Blocks -->
        <div class="lg:col-span-5 space-y-6 text-left">

          <!-- Tactical Status Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 border-2 border-[#2e3545] rounded-full bg-[#14171f] font-mono text-[11px] font-bold text-[#e5b842] shadow-[3px_3px_0px_#e5b842] -rotate-1">
            <span class="w-2 h-2 rounded-full bg-[#e5b842] inline-block animate-pulse"></span>
            <span>AVAILABLE FOR CONTRACT &amp; FULL-TIME</span>
          </div>

          <!-- Architectural Sketchbook Display Header -->
          <h1 class="hero-heading text-[#e6e8ec]">
            Engineering systems with <span class="underline decoration-[3px] decoration-[#e5b842] text-[#e5b842]">uncompromising precision.</span>
          </h1>

          <!-- High-Contrast Body Text -->
          <p class="text-xs font-medium leading-relaxed text-neutral-400 sm:text-sm max-w-xl font-mono">
            Full-stack engineer and technical architect crafting high-concurrency web platforms, resilient distributed backends, and tactile user interfaces.
          </p>

          <!-- Core 3D Tactile Buttons Row with Prominent Block Shadows -->
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a 
              href="/projects" 
              class="px-6 py-3 font-mono font-bold uppercase text-xs text-center border-2 border-[#000000] rounded-xl bg-[#e5b842] text-[#0d0f14] shadow-[4px_4px_0px_0px_#ffffff] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_0px_#ffffff] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all"
            >
              EXPLORE PROJECTS →
            </a>
            <a 
              href="/case-studies" 
              class="px-6 py-3 font-mono font-bold uppercase text-xs text-center border-2 border-[#2e3545] rounded-xl bg-[#1a1e28] text-[#e6e8ec] shadow-[4px_4px_0px_0px_#e5b842] hover:border-[#e5b842] hover:text-[#e5b842] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_0px_#e5b842] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all"
            >
              CASE STUDIES →
            </a>
          </div>

        </div>

        <!-- RIGHT COLUMN: Asymmetrical Workbook Frame with Quick Navigation Directory -->
        <div id="directory" class="lg:col-span-7 relative pt-6 lg:pt-5 w-full">

          <!-- Outer Workbook Frame Wrapper with Signature Block Shadow -->
          <div class="w-full min-h-[420px] border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] pt-14 sm:pt-16 pb-6 sm:pb-8 px-3.5 sm:px-6 relative shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842] overflow-visible grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 items-center">

            <!-- Central Highlighter Curated Resources Bubble -->
            <div class="absolute -top-6 sm:-top-7 left-1/2 -translate-x-1/2 p-3 sm:p-3.5 bg-[#e5b842] border-2 border-[#000000] rounded-2xl sm:rounded-[20px] shadow-[4px_4px_0px_0px_#ffffff] rotate-1 text-center max-w-xs w-[88%] sm:w-full z-20 text-[#0d0f14]">
              <span class="font-poppins text-sm sm:text-base font-bold tracking-wide block leading-tight">
                Portfolio Navigation Hub
              </span>
              <div class="bg-[#0d0f14] border border-[#000000] text-[#e5b842] rounded-md px-2 py-0.5 font-mono text-[10px] font-bold mt-1 inline-block">
                // 4 Core Architecture Pillars
              </div>
            </div>

            <!-- Pillar 1: Projects -->
            <a
              href="/projects"
              class="group p-4 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[4px_4px_0px_0px_#e5b842] hover:shadow-[6px_6px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-[2px] hover:-translate-y-[2px] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all block text-left rotate-0.5 hover:-rotate-0.5"
            >
              <div class="flex items-center gap-2.5 mb-2">
                <div class="w-7 h-7 border-2 border-[#2e3545] bg-[#0d0f14] text-[#e5b842] rounded-lg flex items-center justify-center font-mono font-bold text-xs group-hover:bg-[#e5b842] group-hover:text-[#0d0f14] transition-colors shrink-0">
                  01
                </div>
                <h3 class="font-poppins text-base font-bold tracking-tight text-[#e6e8ec] group-hover:text-[#e5b842] transition-colors">
                  Projects Showcase
                </h3>
              </div>
              <p class="text-xs text-neutral-400 font-mono leading-relaxed">
                Applications, open-source utilities, distributed services, and live production products.
              </p>
            </a>

            <!-- Pillar 2: Case Studies -->
            <a
              href="/case-studies"
              class="group p-4 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[4px_4px_0px_0px_#e5b842] hover:shadow-[6px_6px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-[2px] hover:-translate-y-[2px] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all block text-left -rotate-0.5 hover:rotate-0.5"
            >
              <div class="flex items-center gap-2.5 mb-2">
                <div class="w-7 h-7 border-2 border-[#2e3545] bg-[#0d0f14] text-[#e5b842] rounded-lg flex items-center justify-center font-mono font-bold text-xs group-hover:bg-[#e5b842] group-hover:text-[#0d0f14] transition-colors shrink-0">
                  02
                </div>
                <h3 class="font-poppins text-base font-bold tracking-tight text-[#e6e8ec] group-hover:text-[#e5b842] transition-colors">
                  Case Studies
                </h3>
              </div>
              <p class="text-xs text-neutral-400 font-mono leading-relaxed">
                In-depth architectural breakdowns, performance optimizations, and technical problem solving.
              </p>
            </a>

            <!-- Pillar 3: Career Timeline -->
            <a
              href="/career"
              class="group p-4 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[4px_4px_0px_0px_#e5b842] hover:shadow-[6px_6px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-[2px] hover:-translate-y-[2px] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all block text-left -rotate-0.5 hover:rotate-0.5"
            >
              <div class="flex items-center gap-2.5 mb-2">
                <div class="w-7 h-7 border-2 border-[#2e3545] bg-[#0d0f14] text-[#e5b842] rounded-lg flex items-center justify-center font-mono font-bold text-xs group-hover:bg-[#e5b842] group-hover:text-[#0d0f14] transition-colors shrink-0">
                  03
                </div>
                <h3 class="font-poppins text-base font-bold tracking-tight text-[#e6e8ec] group-hover:text-[#e5b842] transition-colors">
                  Career Timeline
                </h3>
              </div>
              <p class="text-xs text-neutral-400 font-mono leading-relaxed">
                Chronological journey of professional roles, milestones, achievements, and technical growth.
              </p>
            </a>

            <!-- Pillar 4: Technical Blogs -->
            <a
              href="/blogs"
              class="group p-4 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[4px_4px_0px_0px_#e5b842] hover:shadow-[6px_6px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-[2px] hover:-translate-y-[2px] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all block text-left rotate-0.5 hover:-rotate-0.5"
            >
              <div class="flex items-center gap-2.5 mb-2">
                <div class="w-7 h-7 border-2 border-[#2e3545] bg-[#0d0f14] text-[#e5b842] rounded-lg flex items-center justify-center font-mono font-bold text-xs group-hover:bg-[#e5b842] group-hover:text-[#0d0f14] transition-colors shrink-0">
                  04
                </div>
                <h3 class="font-poppins text-base font-bold tracking-tight text-[#e6e8ec] group-hover:text-[#e5b842] transition-colors">
                  Technical Blog
                </h3>
              </div>
              <p class="text-xs text-neutral-400 font-mono leading-relaxed">
                Perspectives on web architecture, systems design, developer tooling, and modern UI practices.
              </p>
            </a>

          </div>
        </div>

      </section>

      <!-- ================= FEATURED PROJECTS SECTION ================= -->
      <section class="relative z-10">
        <div class="relative w-full border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] pt-16 sm:pt-20 pb-8 px-4 sm:px-8 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842] overflow-visible">

          <!-- Central Highlighter Bubble -->
          <div class="absolute -top-6 sm:-top-7 left-1/2 -translate-x-1/2 p-2.5 sm:p-3.5 bg-[#e5b842] border-2 border-[#000000] rounded-2xl shadow-[4px_4px_0px_0px_#ffffff] -rotate-1 text-center max-w-xs w-[88%] sm:w-full z-20 text-[#0d0f14]">
            <span class="font-poppins text-sm sm:text-base font-bold tracking-wide block leading-tight">
              Featured Work
            </span>
            <div class="bg-[#0d0f14] border border-[#000000] text-[#e5b842] rounded px-2 py-0.5 font-mono text-[9px] font-bold mt-0.5 inline-block">
              // Selected Projects
            </div>
          </div>

          <div data-reveal class="text-center max-w-2xl mx-auto mb-8 space-y-2 pt-2">
            <h2 class="section-heading text-[#e6e8ec]">
              Featured Projects
            </h2>
            <p class="text-xs sm:text-sm font-mono text-neutral-400 leading-relaxed">
              Curated web applications, distributed backend services, and developer tools.
            </p>
          </div>

          <!-- Projects Grid with Prominent Block Shadows -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {featuredProjects.slice(0, 3).map((project, index) => {
              const rotation = index === 0 ? 'sm:rotate-0.5' : index === 1 ? 'sm:-rotate-0.5' : 'sm:rotate-0.5';
              return (
                <div 
                  data-reveal 
                  data-reveal-delay={index * 100}
                  class={`p-5 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between ${rotation}`}
                >
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="px-2 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-[#e5b842] rounded text-[10px] font-mono font-bold shadow-[1px_1px_0px_#e5b842]">
                        {project.data.category}
                      </span>
                      <span class="font-mono text-[10px] text-neutral-400">
                        {project.data.role}
                      </span>
                    </div>

                    <h3 class="card-heading text-[#e6e8ec] hover:text-[#e5b842] transition-colors">
                      <a href={`/projects/${project.id}`}>
                        {project.data.title}
                      </a>
                    </h3>

                    <p class="text-xs font-mono text-neutral-400 leading-relaxed line-clamp-3">
                      {project.data.description}
                    </p>

                    <!-- Tech Stack Badges -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {project.data.techStack.map((tech) => (
                        <span class="px-1.5 py-0.5 bg-[#0d0f14] border border-[#2e3545] text-neutral-300 rounded text-[10px] font-mono">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="pt-5 mt-4 border-t border-[#2e3545] flex items-center justify-between font-mono text-xs font-bold">
                    <a href={`/projects/${project.id}`} class="text-[#e5b842] hover:underline flex items-center gap-1">
                      Overview →
                    </a>
                    <div class="flex items-center gap-3">
                      {project.data.githubUrl && (
                        <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-[#e6e8ec]">
                          Code ↗
                        </a>
                      )}
                      {project.data.liveUrl && (
                        <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-[#e5b842]">
                          Live ↗
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}

            {featuredProjects.length === 0 && (
              <div class="col-span-full p-8 text-center border-2 border-dashed border-[#2e3545] rounded-xl bg-[#1a1e28] font-mono text-xs text-neutral-400">
                No projects added yet. Open <a href="/keystatic" class="text-[#e5b842] underline font-bold">/keystatic</a> or add files in <code>src/content/projects/</code> to populate.
              </div>
            )}
          </div>

          <div class="mt-8 text-center">
            <a 
              href="/projects" 
              class="inline-flex items-center gap-2 px-6 py-3 font-mono font-bold uppercase text-xs border-2 border-[#2e3545] rounded-xl bg-[#0d0f14] text-[#e5b842] shadow-[4px_4px_0px_0px_#e5b842] hover:border-[#e5b842] hover:shadow-[6px_6px_0px_0px_#e5b842] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all"
            >
              VIEW ALL PROJECTS ({projects.length}) →
            </a>
          </div>

        </div>
      </section>

      <!-- ================= CASE STUDIES PREVIEW ================= -->
      <section class="relative z-10">
        <div data-reveal class="w-full border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] text-[#e6e8ec] rounded-2xl sm:rounded-[32px] p-6 sm:p-10 relative shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842] overflow-hidden">
          
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4 border-b-2 border-[#2e3545] pb-6">
            <div>
              <div class="inline-block px-3 py-1 border-2 border-[#000000] rounded-full bg-[#e5b842] text-[#0d0f14] font-mono text-[10px] font-bold shadow-[3px_3px_0px_#ffffff] mb-3">
                DEEP DIVES
              </div>
              <h2 class="section-heading text-[#e6e8ec]">
                Architectural Case Studies
              </h2>
              <p class="text-xs sm:text-sm font-mono text-neutral-400 mt-1 max-w-xl">
                Comprehensive breakdowns of high-scale challenges, decisions, and measured outcomes.
              </p>
            </div>
            <a 
              href="/case-studies" 
              class="font-mono text-xs font-bold text-[#e5b842] hover:underline shrink-0"
            >
              All Case Studies →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredCaseStudies.map((study, idx) => (
              <div class="p-6 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between font-mono text-[11px] text-neutral-400">
                    <span class="text-[#e5b842] font-bold">■ {study.data.clientOrProject}</span>
                    <span>{study.data.timeline}</span>
                  </div>
                  <h3 class="font-poppins text-lg font-bold text-[#e6e8ec] hover:text-[#e5b842] transition-colors">
                    <a href={`/case-studies/${study.id}`}>
                      {study.data.title}
                    </a>
                  </h3>
                  <p class="text-xs font-mono text-neutral-400 leading-relaxed">
                    {study.data.summary}
                  </p>

                  {study.data.impactHighlights && study.data.impactHighlights.length > 0 && (
                    <ul class="pt-2 space-y-1 font-mono text-[11px] text-neutral-300">
                      {study.data.impactHighlights.slice(0, 2).map((metric) => (
                        <li class="flex items-start gap-2">
                          <span class="text-[#e5b842]">✔</span>
                          <span>{metric}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <div class="pt-3 border-t border-[#2e3545] flex items-center justify-between font-mono text-xs">
                  <a href={`/case-studies/${study.id}`} class="text-[#e5b842] font-bold hover:underline">
                    Read Full Study →
                  </a>
                  <span class="text-neutral-500 text-[10px]">{study.data.role}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ================= CAREER TIMELINE PREVIEW ================= -->
      <section class="relative z-10">
        <div class="w-full border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] p-6 sm:p-10 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842]">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 border-b-2 border-[#2e3545] pb-6">
            <div>
              <div class="inline-block px-3 py-1 border-2 border-[#2e3545] rounded-full bg-[#0d0f14] text-[#e5b842] font-mono text-[10px] font-bold shadow-[3px_3px_0px_#e5b842] mb-2">
                EXPERIENCE &amp; TIMELINE
              </div>
              <h2 class="section-heading text-[#e6e8ec]">
                Career Trajectory
              </h2>
            </div>
            <a 
              href="/career" 
              class="px-5 py-2.5 font-mono font-bold text-xs uppercase border-2 border-[#000000] rounded-lg bg-[#e5b842] text-[#0d0f14] shadow-[4px_4px_0px_#ffffff] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_#ffffff] transition-all shrink-0"
            >
              EXPLORE FULL TIMELINE →
            </a>
          </div>

          <div class="space-y-4">
            {latestCareer.map((item, idx) => (
              <div class="p-4 sm:p-5 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[4px_4px_0px_0px_#e5b842] flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-[#e5b842] transition-all">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="font-poppins font-bold text-[#e6e8ec] text-sm sm:text-base">
                      {item.data.role}
                    </span>
                    {item.data.current && (
                      <span class="px-2 py-0.5 bg-[#e5b842] text-[#0d0f14] font-mono font-bold text-[9px] rounded">
                        CURRENT
                      </span>
                    )}
                  </div>
                  <p class="font-mono text-xs text-[#e5b842]">
                    {item.data.company} • <span class="text-neutral-400">{item.data.location}</span>
                  </p>
                  <p class="text-xs font-mono text-neutral-400 line-clamp-1">
                    {item.data.summary}
                  </p>
                </div>
                <div class="font-mono text-xs text-neutral-400 sm:text-right shrink-0">
                  <span class="px-2.5 py-1 bg-[#0d0f14] border border-[#2e3545] rounded text-neutral-300 shadow-[2px_2px_0px_#e5b842]">
                    {item.data.startDate} — {item.data.endDate || 'Present'}
                  </span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ================= TECHNICAL BLOG PREVIEW ================= -->
      <section class="relative z-10">
        <div class="w-full border-2 sm:border-[3px] border-[#2e3545] bg-[#14171f] rounded-2xl sm:rounded-[32px] p-6 sm:p-10 shadow-[6px_6px_0px_0px_#e5b842] sm:shadow-[8px_8px_0px_0px_#e5b842]">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 border-b-2 border-[#2e3545] pb-6">
            <div>
              <div class="inline-block px-3 py-1 border-2 border-[#2e3545] rounded-full bg-[#0d0f14] text-[#e5b842] font-mono text-[10px] font-bold shadow-[3px_3px_0px_#e5b842] mb-2">
                WRITINGS
              </div>
              <h2 class="section-heading text-[#e6e8ec]">
                Technical Blog
              </h2>
            </div>
            <a 
              href="/blogs" 
              class="font-mono text-xs font-bold text-[#e5b842] hover:underline"
            >
              All Articles ({blogs.length}) →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {recentBlogs.map((blog, idx) => (
              <div class="p-5 bg-[#1a1e28] border-2 border-[#2e3545] rounded-xl shadow-[5px_5px_0px_0px_#e5b842] hover:shadow-[7px_7px_0px_0px_#e5b842] hover:border-[#e5b842] hover:-translate-x-1 hover:-translate-y-1 transition-all flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between font-mono text-[10px] text-neutral-400">
                    <span>{new Date(blog.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                    <span class="text-[#e5b842] font-bold">{blog.data.readingTime}</span>
                  </div>

                  <h3 class="font-poppins text-base font-bold text-[#e6e8ec] hover:text-[#e5b842] transition-colors">
                    <a href={`/blogs/${blog.id}`}>
                      {blog.data.title}
                    </a>
                  </h3>

                  <p class="text-xs font-mono text-neutral-400 line-clamp-3">
                    {blog.data.summary}
                  </p>
                </div>

                <div class="pt-3 border-t border-[#2e3545] flex items-center justify-between font-mono text-xs">
                  <a href={`/blogs/${blog.id}`} class="text-[#e5b842] font-bold hover:underline">
                    Read Article →
                  </a>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

    </div>
  </div>
</Layout>
