---
// src/pages/techniques/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SEOJsonLd from '../../components/SEOJsonLd.astro';

const collectionTutorials = await getCollection('tutorials');
const allWorkedExamples = await getCollection('tutorialWorkedExamples');
const allPracticeProblems = await getCollection('tutorialPracticeProblems');

// Dynamic list of problem-solving techniques from collection
const techniquesList = collectionTutorials.map(t => {
  const slug = t.id.replace(/\/index$/, '');
  const matchingWorked = allWorkedExamples.filter(e => e.data.tutorialSlug === slug || e.id.startsWith(slug + '/'));
  const matchingPractice = allPracticeProblems.filter(e => e.data.tutorialSlug === slug || e.id.startsWith(slug + '/'));

  return {
    slug,
    title: t.data.title,
    subtitle: t.data.subtitle || '',
    category: t.data.category || 'Combinatorics',
    difficulty: t.data.difficulty || 'Intermediate',
    icon: t.data.icon || '⚡',
    readTime: t.data.estimatedReadTime || '15 min lesson',
    workedCount: matchingWorked.length,
    practiceCount: matchingPractice.length,
    description: t.data.summary || t.data.subtitle || 'Learn step-by-step problem solving tactics.',
    tags: t.data.tags || []
  };
});



function getDifficultyBadgeColor(diff: string) {
  switch (diff) {
    case 'Introductory': return 'bg-emerald-100 text-emerald-800 border-emerald-300';
    case 'Intermediate': return 'bg-amber-100 text-amber-800 border-amber-300';
    case 'Advanced': return 'bg-purple-100 text-purple-800 border-purple-300';
    case 'Olympiad': return 'bg-rose-100 text-rose-800 border-rose-300';
    default: return 'bg-amber-100 text-amber-800 border-amber-300';
  }
}

const allCategoriesCollection = await getCollection('categories');
const standardCategories = ['Combinatorics', 'Algebra', 'Number Theory', 'Geometry', 'Calculus', 'Coordinate Geometry', 'General Strategy'];

// Case-insensitive deduplication map
const categoryMap = new Map<string, string>();
for (const cat of standardCategories) {
  if (cat?.trim()) categoryMap.set(cat.trim().toLowerCase(), cat.trim());
}
for (const c of allCategoriesCollection) {
  const name = (c.data.name || c.id || '').trim();
  if (name && !categoryMap.has(name.toLowerCase())) {
    categoryMap.set(name.toLowerCase(), name.charAt(0).toUpperCase() + name.slice(1));
  }
}
for (const t of techniquesList) {
  const cat = (t.category || '').trim();
  if (cat && !categoryMap.has(cat.toLowerCase())) {
    categoryMap.set(cat.toLowerCase(), cat.charAt(0).toUpperCase() + cat.slice(1));
  }
}

const categories = ['All', ...Array.from(categoryMap.values())];
---


<Layout 
  title="Problem Solving Techniques | deMath Tutorials"
  description="Master competition mathematics with step-by-step problem solving technique lessons, worked demonstration problems, and interactive practice problems with progressive hints."
>
  <SEOJsonLd
    type="collection"
    title="Problem Solving Techniques"
    description="Learn key mathematical techniques: Invariance Principle, Extremal Principle, Pigeonhole Principle, Generating Functions, Double Counting, and more."
    url={Astro.url.href}
  />

  <div class="min-h-screen bg-[#f5f5f2] relative overflow-hidden font-sans pt-12 pb-24">
    <!-- Blueprint Paper Grid Lines -->
    <div class="absolute inset-0 z-0 opacity-[0.04] pointer-events-none"
         style="background-size: 24px 24px; background-image: linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px);">
    </div>

    <main class="max-w-7xl px-4 mx-auto sm:px-6 relative z-10 space-y-12">
      
      <!-- Hero Header Section -->
      <section data-reveal class="text-center space-y-6 max-w-4xl mx-auto pt-4">
        <div class="inline-flex items-center gap-x-2 px-2.5 sm:px-4 py-1 sm:py-1.5 border-2 border-dashed border-[#2a2a2a] rounded-full bg-white shadow-[2px_2px_0px_#2a2a2a]">
          <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-[#ebef70] border border-[#2a2a2a] rounded-full"></span>
          <span class="text-[10px] sm:text-xs font-mono font-bold text-[#2a2a2a] tracking-wide uppercase">Interactive Short Courses</span>
        </div>


        <h1 class="font-sketch hero-heading font-semibold text-[#2a2a2a] leading-none">
          Problem Solving <br />
          <span class="underline decoration-[#ebef70] decoration-8">Techniques</span>
        </h1>

        <p class="text-neutral-600 font-mono text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          Short, self-paced interactive courses on core mathematical problem-solving methods. Each course breaks down foundational theory, worked demonstration problems, and guided practice problems with progressive hints.
        </p>

        <!-- Search & Filter Controls Matrix -->
        <div class="space-y-4 pt-2">
          
          <!-- Search Bar & Dropdowns Row -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-2xl mx-auto">
            <div class="relative w-full sm:flex-1">
              <input
                type="text"
                id="search-input"
                placeholder="Search short courses, tags, concepts..."
                class="w-full pl-9 pr-4 py-2.5 border-2 border-[#2a2a2a] rounded-xl text-xs font-mono font-bold bg-white placeholder:text-neutral-400 focus:outline-none focus:bg-[#ebef70]/20 shadow-[3px_3px_0px_#2a2a2a] transition-all"
              />
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 text-xs font-mono select-none">🔍</span>
            </div>

            <!-- Difficulty Filter Select -->
            <select
              id="difficulty-select"
              class="w-full sm:w-auto px-3.5 py-2.5 border-2 border-[#2a2a2a] rounded-xl text-xs font-mono font-bold bg-white text-[#2a2a2a] shadow-[3px_3px_0px_#2a2a2a] focus:outline-none cursor-pointer"
            >
              <option value="">All Difficulties</option>
              <option value="Introductory">Introductory</option>
              <option value="Intermediate">Intermediate</option>
              <option value="Advanced">Advanced</option>
              <option value="Olympiad">Olympiad</option>
            </select>

            <!-- Mobile Category Select Dropdown -->
            <select
              id="category-select"
              class="w-full sm:hidden px-3.5 py-2.5 border-2 border-[#2a2a2a] rounded-xl text-xs font-mono font-bold bg-white text-[#2a2a2a] shadow-[3px_3px_0px_#2a2a2a] focus:outline-none cursor-pointer"
            >
              {categories.map((cat) => (
                <option value={cat === 'All' ? '' : cat}>{cat === 'All' ? 'All Categories' : cat}</option>
              ))}
            </select>
          </div>

          <!-- Desktop Category Filter Tabs -->
          <div class="hidden sm:flex flex-wrap items-center justify-center gap-2" id="category-filters">
            {categories.map((cat, idx) => (
              <button
                data-category={cat}
                class={`filter-tab px-3.5 py-1.5 rounded-lg font-mono text-xs font-bold border-2 border-[#2a2a2a] transition-all cursor-pointer ${
                  idx === 0 
                    ? 'bg-[#ebef70] shadow-[2px_2px_0px_#2a2a2a]' 
                    : 'bg-white hover:bg-neutral-100 shadow-[2px_2px_0px_#2a2a2a]'
                }`}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Active Filter Status & Count Bar -->
          <div class="flex items-center justify-between text-xs font-mono font-bold text-neutral-500 pt-2 border-t border-dashed border-neutral-300">
            <span id="results-count">Showing {techniquesList.length} Short Courses</span>
            <button id="reset-filters-btn" class="hidden text-indigo-600 underline hover:text-[#2a2a2a] font-bold cursor-pointer">
              Reset Filters ↺
            </button>
          </div>

        </div>
      </section>

      <!-- Tutorial Cards Grid Container -->
      <section class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="techniques-grid">
          <!-- Empty State Message When Filter Finds Nothing -->
          <div id="no-techniques-msg" class="hidden col-span-full py-12 text-center bg-white border-[3px] border-[#2a2a2a] rounded-2xl p-8 shadow-[6px_6px_0px_0px_#2a2a2a] space-y-3">
            <div class="text-2xl font-sketch font-bold text-[#2a2a2a]">No Short Courses Match Your Filters</div>
            <p class="text-xs font-mono text-neutral-500">Try clearing your search query or selecting a different category/difficulty.</p>
            <button id="empty-reset-btn" class="mt-2 px-4 py-2 bg-[#ebef70] border-2 border-[#2a2a2a] rounded-lg font-mono text-xs font-bold shadow-[2px_2px_0px_#2a2a2a] hover:bg-yellow-300">
              Clear All Filters
            </button>
          </div>

          {techniquesList.map((item, idx) => (
            <article 
              data-reveal
              data-reveal-delay={Math.min(idx, 5) * 80}
              data-category={item.category}
              data-difficulty={item.difficulty}
              data-title={item.title.toLowerCase()}
              data-subtitle={item.subtitle.toLowerCase()}
              data-tags={item.tags.join(' ').toLowerCase()}
              data-description={item.description.toLowerCase()}
              class="technique-card bg-white border-2 sm:border-[3px] border-[#2a2a2a] rounded-xl sm:rounded-2xl p-4 sm:p-6 shadow-[4px_4px_0px_0px_#2a2a2a] sm:shadow-[6px_6px_0px_0px_#2a2a2a] hover:translate-x-[-1px] hover:translate-y-[-1px] sm:hover:translate-x-[-2px] sm:hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_#2a2a2a] sm:hover:shadow-[8px_8px_0px_0px_#2a2a2a] transition-all flex flex-col justify-between space-y-4 sm:space-y-6"
            >
              <!-- Card Top Header -->
              <div class="space-y-3 sm:space-y-4">
                <div class="flex items-center justify-between">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-[#ebef70] border-2 border-[#2a2a2a] flex items-center justify-center font-mono font-black text-xs text-[#2a2a2a] shadow-[2px_2px_0px_#2a2a2a]">
                    {String(idx + 1).padStart(2, '0')}
                  </div>
                  <div class="flex items-center gap-1.5 sm:gap-2">
                    <span class={`px-2 sm:px-2.5 py-0.5 sm:py-1 rounded text-[10px] font-mono font-bold border ${getDifficultyBadgeColor(item.difficulty)}`}>
                      {item.difficulty}
                    </span>
                    <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 bg-neutral-100 border border-neutral-300 text-neutral-600 rounded text-[10px] font-mono font-bold">
                      {item.category}
                    </span>
                  </div>
                </div>

                <div>
                  <h2 class="font-sketch text-xl sm:text-2xl font-bold text-[#2a2a2a] hover:text-indigo-600 transition-colors">
                    <a href={`/techniques/${item.slug}`}>
                      {item.title}
                    </a>
                  </h2>
                  {item.subtitle && (
                    <p class="text-xs font-mono font-bold text-neutral-400 mt-1">
                      {item.subtitle}
                    </p>
                  )}
                </div>

                <p class="text-xs text-neutral-600 leading-relaxed font-sans font-medium line-clamp-3">
                  {item.description}
                </p>

                <!-- Tags list -->
                {item.tags && item.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1 pt-1">
                    {item.tags.map(tag => (
                      <button 
                        type="button"
                        data-tag-query={tag}
                        class="tag-pill px-2 py-0.5 bg-neutral-50 hover:bg-[#ebef70] border border-neutral-200 hover:border-[#2a2a2a] text-neutral-500 hover:text-[#2a2a2a] rounded text-[9px] font-mono transition-colors cursor-pointer"
                      >
                        #{tag}
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <!-- Card Bottom Footer / Metas -->
              <div class="pt-3.5 sm:pt-4 border-t-2 border-dashed border-neutral-200 space-y-3 sm:space-y-4">
                <div class="grid grid-cols-3 gap-1.5 text-center font-mono text-[10px] sm:text-[11px]">
                  <div class="p-1.5 sm:p-2 bg-indigo-50 border border-indigo-200 rounded-lg text-indigo-800 font-bold truncate">
                    ⏱ {item.readTime}
                  </div>
                  <div class="p-1.5 sm:p-2 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800 font-bold truncate">
                    {item.workedCount} Examples
                  </div>
                  <div class="p-1.5 sm:p-2 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 font-bold truncate">
                    {item.practiceCount} Problems
                  </div>
                </div>

                <a 
                  href={`/techniques/${item.slug}`}
                  class="w-full py-2 sm:py-2.5 px-4 rounded-xl bg-[#ebef70] border-2 border-[#2a2a2a] text-xs font-mono font-bold text-[#2a2a2a] text-center shadow-[2px_2px_0px_#2a2a2a] sm:shadow-[3px_3px_0px_#2a2a2a] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_#2a2a2a] transition-all flex items-center justify-center gap-2 uppercase tracking-wider"
                >
                  <span>Read</span>
                  <span>→</span>
                </a>

              </div>
            </article>
          ))}
        </div>

        <!-- Responsive Pagination Controls -->
        <div id="pagination-controls" class="flex flex-wrap items-center justify-center gap-2 pt-6 border-t-2 border-dashed border-neutral-300">
          <button
            id="prev-page-btn"
            class="px-4 py-2 rounded-xl border-2 border-[#2a2a2a] bg-white font-mono text-xs font-bold text-[#2a2a2a] shadow-[2px_2px_0px_#2a2a2a] disabled:opacity-40 disabled:pointer-events-none hover:bg-neutral-100 transition-all cursor-pointer"
          >
            ← Previous
          </button>

          <div id="page-numbers" class="flex items-center gap-1.5">
            <!-- Dynamic page pills rendered by JS -->
          </div>

          <button
            id="next-page-btn"
            class="px-4 py-2 rounded-xl border-2 border-[#2a2a2a] bg-white font-mono text-xs font-bold text-[#2a2a2a] shadow-[2px_2px_0px_#2a2a2a] disabled:opacity-40 disabled:pointer-events-none hover:bg-neutral-100 transition-all cursor-pointer"
          >
            Next →
          </button>
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  function setupInteractiveTechniques() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const difficultySelect = document.getElementById('difficulty-select') as HTMLSelectElement | null;
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const categoryButtons = document.querySelectorAll('.filter-tab');
    const cards = Array.from(document.querySelectorAll('.technique-card')) as HTMLElement[];
    const emptyMsg = document.getElementById('no-techniques-msg');
    const resultsCountEl = document.getElementById('results-count');
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
    const pageNumbersContainer = document.getElementById('page-numbers');
    const paginationContainer = document.getElementById('pagination-controls');

    if (!cards.length) return;

    let currentCategory = 'All';
    let currentDifficulty = '';
    let searchQuery = '';
    let currentPage = 1;
    const itemsPerPage = 6;

    function applyFilterAndPaginate() {
      const q = searchQuery.toLowerCase().trim();
      const cat = currentCategory.toLowerCase();
      const diff = currentDifficulty.toLowerCase();

      // 1. Filter matching cards
      const matchingCards: HTMLElement[] = [];
      cards.forEach(card => {
        const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
        const cardDiff = (card.getAttribute('data-difficulty') || '').toLowerCase();
        const cardTitle = (card.getAttribute('data-title') || '');
        const cardSubtitle = (card.getAttribute('data-subtitle') || '');
        const cardTags = (card.getAttribute('data-tags') || '');
        const cardDesc = (card.getAttribute('data-description') || '');

        const matchesCat = cat === 'all' || cardCat === cat;
        const matchesDiff = !diff || cardDiff === diff;
        const matchesQuery = !q || (
          cardTitle.includes(q) ||
          cardSubtitle.includes(q) ||
          cardTags.includes(q) ||
          cardDesc.includes(q) ||
          cardCat.includes(q)
        );

        if (matchesCat && matchesDiff && matchesQuery) {
          matchingCards.push(card);
        }
      });

      const totalMatches = matchingCards.length;
      const totalPages = Math.max(1, Math.ceil(totalMatches / itemsPerPage));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // 2. Hide all cards, then reveal only current page slice
      cards.forEach(c => { c.style.display = 'none'; c.classList.remove('in-view'); });

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const pageSlice = matchingCards.slice(startIndex, endIndex);

      // Show cards first (display:flex), then on next frame add .in-view so CSS transition fires
      pageSlice.forEach((c, i) => {
        c.style.display = 'flex';
        requestAnimationFrame(() => {
          setTimeout(() => c.classList.add('in-view'), i * 80);
        });
      });


      // 3. Update results counter & reset button
      if (resultsCountEl) {
        resultsCountEl.textContent = `Showing ${totalMatches} Short Course${totalMatches === 1 ? '' : 's'}`;
      }

      const isFiltered = currentCategory !== 'All' || currentDifficulty !== '' || searchQuery !== '';
      if (resetBtn) {
        if (isFiltered) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }

      // 4. Update empty state message
      if (emptyMsg) {
        if (totalMatches === 0) {
          emptyMsg.classList.remove('hidden');
        } else {
          emptyMsg.classList.add('hidden');
        }
      }

      // 5. Update pagination UI
      if (paginationContainer) {
        if (totalMatches <= itemsPerPage) {
          paginationContainer.classList.add('hidden');
        } else {
          paginationContainer.classList.remove('hidden');
        }
      }

      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.textContent = String(i);
          pageBtn.className = `w-8 h-8 rounded-lg font-mono text-xs font-bold border-2 border-[#2a2a2a] transition-all cursor-pointer ${
            i === currentPage
              ? 'bg-[#ebef70] shadow-[2px_2px_0px_#2a2a2a]'
              : 'bg-white hover:bg-neutral-100 shadow-[1px_1px_0px_#2a2a2a]'
          }`;
          pageBtn.addEventListener('click', () => {
            currentPage = i;
            applyFilterAndPaginate();
            window.scrollTo({ top: 120, behavior: 'smooth' });
          });
          pageNumbersContainer.appendChild(pageBtn);
        }
      }
    }

    // Search Input Listener
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      currentPage = 1;
      applyFilterAndPaginate();
    });

    // Difficulty Dropdown Listener
    difficultySelect?.addEventListener('change', (e) => {
      currentDifficulty = (e.target as HTMLSelectElement).value;
      currentPage = 1;
      applyFilterAndPaginate();
    });

    // Mobile Category Select Dropdown Listener
    categorySelect?.addEventListener('change', (e) => {
      const selected = (e.target as HTMLSelectElement).value || 'All';
      setCategory(selected);
    });

    // Desktop Category Filter Tabs
    function setCategory(cat: string) {
      currentCategory = cat;
      currentPage = 1;

      categoryButtons.forEach(b => {
        const btnCat = b.getAttribute('data-category') || 'All';
        if (btnCat.toLowerCase() === cat.toLowerCase()) {
          b.classList.add('bg-[#ebef70]', 'shadow-[2px_2px_0px_#2a2a2a]');
          b.classList.remove('bg-white');
        } else {
          b.classList.remove('bg-[#ebef70]', 'shadow-[2px_2px_0px_#2a2a2a]');
          b.classList.add('bg-white');
        }
      });

      if (categorySelect) {
        categorySelect.value = cat === 'All' ? '' : cat;
      }

      applyFilterAndPaginate();
    }

    categoryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = (btn.getAttribute('data-category') || 'All').trim();
        setCategory(cat);
      });
    });

    // Tag Pills Click Handler (Search by Tag)
    document.querySelectorAll('.tag-pill').forEach(pill => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = pill.getAttribute('data-tag-query') || '';
        if (searchInput) {
          searchInput.value = tag;
          searchQuery = tag;
          currentPage = 1;
          applyFilterAndPaginate();
          window.scrollTo({ top: 180, behavior: 'smooth' });
        }
      });
    });

    // Reset Buttons Handler
    function resetAllFilters() {
      searchQuery = '';
      currentDifficulty = '';
      if (searchInput) searchInput.value = '';
      if (difficultySelect) difficultySelect.value = '';
      setCategory('All');
    }

    resetBtn?.addEventListener('click', resetAllFilters);
    emptyResetBtn?.addEventListener('click', resetAllFilters);

    // Pagination Button Handlers
    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        applyFilterAndPaginate();
        window.scrollTo({ top: 120, behavior: 'smooth' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      currentPage++;
      applyFilterAndPaginate();
      window.scrollTo({ top: 120, behavior: 'smooth' });
    });

    // Initial Execution
    applyFilterAndPaginate();
  }

  setupInteractiveTechniques();
  document.addEventListener('astro:page-load', setupInteractiveTechniques);
</script>

