<script>
  function setupHintAndSolutionToggles() {
    // 1. Progressive Hint Toggles
    const hintToggles = document.querySelectorAll('.hint-toggle');
    hintToggles.forEach(btn => {
      // Remove any existing click listener by cloning or fresh check
      if ((btn as any)._hasListener) return;
      (btn as any)._hasListener = true;

      btn.addEventListener('click', () => {
        const container = btn.closest('.hint-container');
        if (!container) return;
        const content = container.querySelector('.hint-content');
        const icon = container.querySelector('.toggle-icon');
        const status = container.querySelector('.hint-status');

        if (content) {
          const isHidden = content.classList.contains('hidden');
          if (isHidden) {
            content.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (icon) icon.textContent = '−';
            if (status) status.textContent = 'Hide Hint';
            
            // Re-render KaTeX on dynamic un-hide
            if ((window as any).renderMathInElement) {
              (window as any).renderMathInElement(content, {
                delimiters: [
                  {left: '$$', right: '$$', display: true},
                  {left: '$', right: '$', display: false},
                  {left: '\\(', right: '\\)', display: false},
                  {left: '\\[', right: '\\]', display: true}
                ],
                throwOnError: false
              });
            }
          } else {
            content.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (icon) icon.textContent = '+';
            if (status) status.textContent = 'Show Hint';
          }
        }
      });
    });

    // 2. Master Solution Toggles
    const solutionToggles = document.querySelectorAll('.solution-toggle');
    solutionToggles.forEach(btn => {
      if ((btn as any)._hasListener) return;
      (btn as any)._hasListener = true;

      btn.addEventListener('click', () => {
        const container = btn.closest('.solution-container');
        if (!container) return;
        const content = container.querySelector('.solution-content');
        const chevron = container.querySelector('.solution-chevron');
        const status = container.querySelector('.solution-btn-status');

        if (content) {
          const isHidden = content.classList.contains('hidden');
          if (isHidden) {
            content.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (chevron) (chevron as HTMLElement).style.transform = 'rotate(180deg)';
            if (status) status.textContent = 'Hide Solution';

            // Re-render KaTeX on dynamic un-hide
            if ((window as any).renderMathInElement) {
              (window as any).renderMathInElement(content, {
                delimiters: [
                  {left: '$$', right: '$$', display: true},
                  {left: '$', right: '$', display: false},
                  {left: '\\(', right: '\\)', display: false},
                  {left: '\\[', right: '\\]', display: true}
                ],
                throwOnError: false
              });
            }
          } else {
            content.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (chevron) (chevron as HTMLElement).style.transform = 'rotate(0deg)';
            if (status) status.textContent = 'Show Solution';
          }
        }
      });
    });
  }

  // Setup on page load
  setupHintAndSolutionToggles();
  document.addEventListener('astro:page-load', setupHintAndSolutionToggles);

  function setupScrollSpy() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.outline-link');
    const sections = ['theory', 'worked-examples', 'practice-problems']
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (links.length === 0 || sections.length === 0) return;

    function updateActiveOutline() {
      const scrollPos = window.scrollY + 140;

      let currentSectionId = '';
      for (const section of sections) {
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentSectionId = section.id;
          break;
        }
      }

      // If at top of page, default to first
      if (!currentSectionId && window.scrollY < (sections[0]?.offsetTop || 0)) {
        currentSectionId = sections[0]?.id || '';
      }
      // If at very bottom of page, default to last
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 80) {
        currentSectionId = sections[sections.length - 1]?.id || '';
      }

      links.forEach(link => {
        const sectionAttr = link.getAttribute('data-section');
        if (sectionAttr === currentSectionId) {
          link.classList.add('bg-[#ebef70]', 'border-[#2a2a2a]', 'shadow-[2px_2px_0px_#2a2a2a]', 'text-[#2a2a2a]');
          link.classList.remove('border-transparent', 'text-neutral-600');
        } else {
          link.classList.remove('bg-[#ebef70]', 'border-[#2a2a2a]', 'shadow-[2px_2px_0px_#2a2a2a]', 'text-[#2a2a2a]');
          link.classList.add('border-transparent', 'text-neutral-600');
        }
      });
    }

    window.addEventListener('scroll', updateActiveOutline, { passive: true });
    updateActiveOutline();
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupHintAndSolutionToggles();
    setupScrollSpy();
  });
  document.addEventListener('astro:page-load', () => {
    setupHintAndSolutionToggles();
    setupScrollSpy();
  });
</script>
