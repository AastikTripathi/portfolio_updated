---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="border-t-2 border-[#282d38] bg-[#161920] font-sans py-12 mt-auto relative z-10 text-[#e6e8ec]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Biography & Scaffolding Info -->
    <div class="lg:col-span-6 space-y-4 text-center lg:text-left">
      <div class="inline-block px-3 py-1 border-2 border-[#090a0d] bg-[#e5b842] text-[#0f1115] font-mono text-[10px] font-bold tracking-widest uppercase rounded-full shadow-[2px_2px_0px_#090a0d]">
        Portfolio &amp; Project Scaffolding
      </div>
      <h4 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#e6e8ec] uppercase font-poppins">
        Aastik Tripathi
      </h4>
      <p class="text-xs font-mono text-neutral-400 leading-relaxed max-w-xl">
        Engineering scalable web applications, robust distributed systems, and modern digital experiences. Available for consulting, architectural reviews, and high-impact engineering roles.
      </p>
    </div>

    <!-- Right Column: Contact Details and Social Links -->
    <div class="lg:col-span-6 flex flex-col items-center lg:items-end space-y-4">
      <span class="font-mono text-xs font-bold text-[#e5b842] tracking-wider uppercase">// Connect &amp; Collaborate</span>
      
      <!-- Email Badge -->
      <div class="flex flex-col items-center lg:items-end gap-1">
        <a 
          href="mailto:contact@aastik.dev" 
          class="px-4 py-2 border-2 border-[#090a0d] bg-[#e5b842] text-xs font-mono font-bold text-[#0f1115] rounded-lg shadow-[2px_2px_0px_#090a0d] hover:translate-x-[1px] hover:translate-y-[1px] transition-all flex items-center gap-1.5"
        >
          contact@aastik.dev
        </a>
        <span class="text-[9px] font-mono text-neutral-400 font-medium uppercase tracking-wider flex items-center gap-1 mt-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span> Open for Opportunities
        </span>
      </div>

      <!-- Social Links (GitHub, LinkedIn, Twitter/X) -->
      <div class="flex items-center gap-3 pt-2">
        <a 
          href="https://github.com/AastikTripathi" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 border-2 border-[#282d38] bg-[#1c2028] text-neutral-300 rounded-lg hover:border-[#e5b842] hover:text-[#e5b842] shadow-[2px_2px_0px_#090a0d] active:translate-x-[1px] active:translate-y-[1px] transition-all"
          aria-label="GitHub Profile"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a 
          href="https://linkedin.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 border-2 border-[#282d38] bg-[#1c2028] text-neutral-300 rounded-lg hover:border-[#e5b842] hover:text-[#e5b842] shadow-[2px_2px_0px_#090a0d] active:translate-x-[1px] active:translate-y-[1px] transition-all"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>

    </div>

  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 mt-8 border-t border-[#282d38] flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-neutral-500">
    <p>© {year} Aastik Tripathi. All rights reserved.</p>
    <p class="flex items-center gap-1.5">
      <span>Built with</span>
      <span class="text-[#e5b842] font-semibold">Astro</span>
      <span>&amp;</span>
      <span class="text-[#e5b842] font-semibold">Keystatic</span>
    </p>
  </div>
</footer>
