---
// src/components/Navbar.astro
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'HOME', href: '/' },
  { name: 'PROJECTS', href: '/projects' },
  { name: 'CASE STUDIES', href: '/case-studies' },
  { name: 'CAREER', href: '/career' },
  { name: 'BLOG', href: '/blogs' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b-2 border-[#2e3545] bg-[#14171f]/95 backdrop-blur font-sans">
  <div class="flex items-center justify-between h-16 max-w-7xl px-4 mx-auto sm:px-6">

    <!-- Branding Logo Group -->
    <a href="/" class="flex items-center gap-2.5 group">
       <div class="h-9 w-9 rounded-lg bg-[#0d0f14] border-2 border-[#2e3545] flex items-center justify-center font-mono font-bold text-xs text-[#e5b842] shadow-[2px_2px_0px_#e5b842] group-hover:bg-[#e5b842] group-hover:text-[#0d0f14] group-hover:border-[#000000] group-hover:shadow-[2px_2px_0px_#ffffff] transition-all shrink-0">
          AT.
       </div>
       <div class="flex flex-col text-left">
          <span class="font-poppins text-base font-bold tracking-tight text-[#e6e8ec] leading-none group-hover:text-[#e5b842] transition-colors">
             Aastik Tripathi
          </span>
          <span class="font-mono text-[10px] font-medium text-neutral-400 tracking-tight leading-tight mt-0.5">
             // portfolio &amp; archive
          </span>
       </div>
    </a>

    <!-- Navigation Menu Matrix (Desktop) -->
    <nav class="hidden md:flex items-center space-x-1.5 font-mono text-xs font-bold">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-1.5 rounded-lg border-2 transition-all ${
            isActive(item.href)
              ? 'border-[#000000] bg-[#e5b842] text-[#0d0f14] shadow-[3px_3px_0px_#ffffff]'
              : 'border-transparent text-neutral-300 hover:border-[#2e3545] hover:text-[#e5b842] hover:bg-[#1a1e28]'
          }`}
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Header Action Button -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="mailto:contact@aastik.dev"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 font-mono font-bold text-xs uppercase border-2 border-[#000000] rounded-lg bg-[#e5b842] text-[#0d0f14] shadow-[3px_3px_0px_0px_#ffffff] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_#ffffff] transition-all"
      >
        <span>GET IN TOUCH</span>
        <span>→</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-nav-toggle"
      aria-label="Toggle Navigation Menu"
      class="md:hidden p-2 rounded-lg border-2 border-[#2e3545] bg-[#1a1e28] text-[#e5b842] shadow-[2px_2px_0px_#e5b842] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all"
    >
      <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t-2 border-[#2e3545] bg-[#14171f] px-4 py-4 space-y-2 font-mono text-xs font-bold">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-4 py-2.5 rounded-lg border-2 transition-all ${
          isActive(item.href)
            ? 'border-[#000000] bg-[#e5b842] text-[#0d0f14] shadow-[3px_3px_0px_#ffffff]'
            : 'border-[#2e3545] text-neutral-300 bg-[#1a1e28] hover:border-[#e5b842]'
        }`}
      >
        {item.name}
      </a>
    ))}
    <div class="pt-2">
      <a
        href="mailto:contact@aastik.dev"
        class="block w-full text-center py-2.5 rounded-lg border-2 border-[#000000] bg-[#e5b842] text-[#0d0f14] font-bold shadow-[3px_3px_0px_#ffffff]"
      >
        GET IN TOUCH →
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    hamburger?.classList.toggle('hidden', !isHidden);
    close?.classList.toggle('hidden', isHidden);
  });
</script>
