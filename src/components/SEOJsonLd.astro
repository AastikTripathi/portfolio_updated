---
// src/components/SEOJsonLd.astro
interface Props {
  type: 'website' | 'article' | 'about';
  title: string;
  description: string;
  url: string;
  tags?: string[];
  datePublished?: string;
  author?: string;
  image?: string;
  breadcrumbs?: Array<{ name: string; item: string }>;
}

const {
  type,
  title,
  description,
  url,
  tags = [],
  datePublished,
  author = 'Aastik Tripathi',
  image = '/favicon.svg',
  breadcrumbs
} = Astro.props;

const siteUrl = 'https://aastiktripathi.pages.dev';

const personSchema = {
  '@type': 'Person',
  name: 'Aastik Tripathi',
  url: siteUrl,
  jobTitle: 'Full Stack Engineer & Systems Architect',
  sameAs: [
    'https://github.com/AastikTripathi',
  ]
};

let schema: Record<string, any> = {
  '@context': 'https://schema.org',
};

if (type === 'website') {
  schema = {
    ...schema,
    '@type': 'WebSite',
    name: 'Aastik Tripathi - Developer Portfolio',
    url: siteUrl,
    description: description,
    author: personSchema,
  };
} else if (type === 'article') {
  schema = {
    ...schema,
    '@type': 'Article',
    headline: title,
    description: description,
    url: url,
    datePublished: datePublished || new Date().toISOString(),
    author: personSchema,
    keywords: tags.join(', '),
  };
} else {
  schema = {
    ...schema,
    ...personSchema,
    description: description,
  };
}

if (breadcrumbs && breadcrumbs.length > 0) {
  schema['breadcrumb'] = {
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: crumb.name,
      item: crumb.item.startsWith('http') ? crumb.item : `${siteUrl}${crumb.item}`,
    })),
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
